@model Khoa
@{
    // Thêm bài học vào một chủ đề (mở từ menu ⋮ của chủ đề)
    var chuDe = (ChuDe)ViewBag.ChuDe;
    ViewData["Title"] = "Thêm bài học";
    ViewData["TieuDe"] = "Thêm bài học";
    ViewData["Muc"] = "NoiDung";
    ViewData["Crumb"] = $"<a href=\"/GiangVien/NoiDung\">Khoá học của tôi</a> › <a href=\"/GiangVien/NoiDung?khoa={Model.Id}\">{Model.Ten}</a> › {chuDe.Ten}";
    string? Nhap(string ten) => ViewData.ModelState[ten]?.AttemptedValue;
    var moNhap = !string.IsNullOrEmpty(Nhap("noiDung"));
}
@section Actions { <a href="/GiangVien/NoiDung?khoa=@Model.Id" class="ql-nut phu">← Về khoá học</a> }
<div style="max-width: 820px">
<section class="ql-khoi" aria-labelledby="bai-moi">
<div class="ql-khoi-dau"><h2 id="bai-moi">Bài mới trong @chuDe.Ten</h2><span class="ql-phu">Lưu ở dạng nháp</span></div>
<form method="post" asp-action="ThemBai" class="ql-khoi-than ql-hang-nut" style="align-items: flex-end">
<input type="hidden" name="chuDeId" value="@chuDe.Id">
<div class="ql-truong" style="flex: 0 0 100px; margin: 0"><label for="soBaiMoi">Số bài</label><input id="soBaiMoi" type="number" name="soBai" min="1" step="1" value="@ViewBag.SoBaiGoiY" required></div>
<div class="ql-truong" style="flex: 1 1 260px; margin: 0"><label for="tenBaiMoi">Tên bài</label><input id="tenBaiMoi" type="text" name="ten" placeholder="Ví dụ: Công cuộc Đổi mới" required autofocus></div>
<button class="ql-nut">Tạo bài</button>
</form>
</section>

<details class="ql-khoi sb-nhap" open="@moNhap">
<summary><span><b>Nhập từ tài liệu</b><small>Tài liệu có "Bài 1…", "Bài 2…" thì tự tách thành từng bài kèm các mục</small></span></summary>
<form method="post" asp-action="TaoChuDeBangAi" class="ql-khoi-than ql-form" data-soan-noi-dung>
<input type="hidden" name="chuDeId" value="@chuDe.Id"><input type="hidden" name="khoaId" value="@Model.Id">
<partial name="_NhapTaiLieu" />
<div class="ql-truong"><label for="noiDung">Nội dung</label><textarea id="noiDung" name="noiDung" rows="8" minlength="30" maxlength="30000" placeholder="Dán tài liệu (Bài 1, Bài 2…) hoặc nội dung một bài…" required>@Nhap("noiDung")</textarea></div>
<details class="tcd-mot-bai" open="@(!string.IsNullOrEmpty(Nhap("tenBai")))">
<summary>Tài liệu chỉ có một bài?</summary>
<div class="ql-hang-nut" style="align-items: flex-end; margin-top: 10px">
<div class="ql-truong" style="flex: 0 0 100px; margin: 0"><label for="soBai">Số bài</label><input id="soBai" type="number" name="soBai" min="1" step="1" value="@(Nhap("soBai") ?? ViewBag.SoBaiGoiY?.ToString())"></div>
<div class="ql-truong" style="flex: 1 1 260px; margin: 0"><label for="tenBai">Tên bài</label><input id="tenBai" type="text" name="tenBai" value="@Nhap("tenBai")"></div>
</div>
</details>
<p class="ql-phu" data-soan-status role="status" aria-live="polite" hidden></p>
<div class="ql-chan"><button class="ql-nut phu" type="submit" name="chiaTheoVanBan" value="true">Chia theo đề mục</button><button class="ql-nut" type="submit">✦ Chia bằng AI</button></div>
</form>
</details>
</div>
@section Scripts {
<script src="~/js/soan-noi-dung.js" asp-append-version="true"></script>
<script src="~/js/nhap-tai-lieu.js" asp-append-version="true"></script>
}
