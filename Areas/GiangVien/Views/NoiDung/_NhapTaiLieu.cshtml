<div class="ql-truong ql-nhap-tl" data-nhap-tai-lieu>
<label for="taiLieu">Nhập từ Word / PowerPoint</label>
<input id="taiLieu" type="file" accept=".docx,.pptx" aria-describedby="taiLieuGhiChu">
<small id="taiLieuGhiChu">.docx, .pptx · tối đa 20 MB · chỉ lấy chữ, không lấy ảnh</small>
<p data-nhap-status role="status" aria-live="polite" hidden></p>
<ul data-nhap-canh-bao class="ql-phu" hidden></ul>
<button type="button" class="ql-nut phu" data-ap-dung-file hidden>Điền nội dung từ file</button>
</div>
