@model Bai
@{
    ViewData["Title"] = $"Soạn Bài {Model.So} – Giảng viên";
    ViewData["TieuDe"] = $"Bài {Model.So}. {Model.Ten}";
    ViewData["Muc"] = "NoiDung";
    ViewData["Crumb"] = $"<a href=\"/GiangVien/NoiDung\">Khoá học của tôi</a> › <a href=\"/GiangVien/NoiDung?khoa={Model.ChuDe!.KhoaId}\">{Model.ChuDe.Khoa!.Ten}</a> › {Model.ChuDe.Ten}";
    var dsMuc = Model.Muc.OrderBy(x => x.So).ToList();
    var noiDungNhap = ViewData.ModelState["noiDung"]?.AttemptedValue;
    // Bài chưa có mục, hoặc vừa nhập lỗi: mở sẵn khối nhập nhanh
    var moNhapNhanh = dsMuc.Count == 0 || !string.IsNullOrEmpty(noiDungNhap);
}
@section Actions {
<button type="button" class="ql-nut phu" data-xem-truoc data-src="/GiangVien/NoiDung/XemTruoc/@Model.Id">Xem trước</button>
}

<div class="sb-luoi">
<div class="sb-chinh">

<section class="ql-khoi" aria-labelledby="muc">
<div class="ql-khoi-dau"><h2 id="muc">Nội dung bài</h2><span class="ql-phu">@dsMuc.Count mục</span></div>
@if (dsMuc.Count == 0)
{
<p class="sb-trong">Bài chưa có mục nào. Thêm mục bên dưới hoặc nhập nhanh từ tài liệu.</p>
}
else
{
<ol class="sb-muc">
@foreach (var m in dsMuc)
{
<li>
<span class="sb-muc-so">@m.So</span>
<a href="/GiangVien/NoiDung/SuaMuc/@m.Id" class="sb-muc-ten">@m.Ten<small>@m.Phan.Count phần</small></a>
<span class="ql-hang-nut">
<a href="/GiangVien/NoiDung/SuaMuc/@m.Id" class="ql-nut phu nho">Soạn</a>
<form method="post" asp-action="XoaMuc" data-hoi="Xoá mục @m.So và toàn bộ nội dung của mục?"><input type="hidden" name="id" value="@m.Id"><button class="ql-nut xoa nho" aria-label="Xoá mục @m.So">Xoá</button></form>
</span>
</li>
}
</ol>
}
<form method="post" asp-action="ThemMuc" class="sb-them">
<input type="hidden" name="baiId" value="@Model.Id">
<input type="text" name="ten" placeholder="Tên mục mới, ví dụ: Bối cảnh" aria-label="Tên mục mới" required>
<button class="ql-nut">+ Thêm mục</button>
</form>
</section>

<details class="ql-khoi sb-nhap" open="@moNhapNhanh">
<summary><span><b>Nhập nhanh từ tài liệu hoặc AI</b><small>Tự chia thành các mục, xem lại trước khi lưu vào bài</small></span></summary>
<form method="post" asp-action="TaoNoiDungBangAi" class="ql-khoi-than ql-form" data-soan-noi-dung>
<input type="hidden" name="baiId" value="@Model.Id">
<partial name="_NhapTaiLieu" />
<div class="ql-truong"><label for="noiDungAi">Nội dung</label><textarea id="noiDungAi" name="noiDung" rows="8" minlength="30" maxlength="30000" required placeholder="Dán nội dung, dàn ý hoặc ghi chú buổi học…">@noiDungNhap</textarea><small>Có sẵn đề mục (#, I., 1., a)…) thì chọn "Chia theo đề mục"; chưa có thì dùng AI.</small></div>
<p class="ql-phu" data-soan-status role="status" aria-live="polite" hidden></p>
<div class="ql-chan"><button class="ql-nut" type="submit">✦ Chia bằng AI</button><button class="ql-nut phu" type="submit" name="chiaTheoVanBan" value="true">Chia theo đề mục</button></div>
</form>
</details>

</div>

<aside class="sb-ben" aria-label="Thông tin bài">
<section class="ql-khoi" aria-labelledby="thong-tin">
<div class="ql-khoi-dau"><h2 id="thong-tin">Thông tin bài</h2>@if (Model.DaXuatBan) { <span class="ql-chip xanh">Đã xuất bản</span> } else { <span class="ql-chip vang">Nháp</span> }</div>
<form method="post" asp-action="LuuBai" class="ql-khoi-than ql-form">
<input type="hidden" name="id" value="@Model.Id">
<div class="ql-truong"><label for="ten">Tên bài</label><textarea id="ten" name="ten" rows="2" required>@Model.Ten</textarea></div>
<div class="ql-truong" style="max-width: 110px"><label for="soBai">Số bài</label><input id="soBai" type="number" name="soBai" min="1" step="1" value="@Model.So" required></div>
<label class="ql-check"><input type="checkbox" name="daXuatBan" value="true" checked="@Model.DaXuatBan"> Xuất bản cho học viên</label>
<label class="ql-check"><input type="checkbox" name="hocThu" value="true" checked="@Model.HocThu"> Cho học thử miễn phí</label>
<div class="ql-chan"><button class="ql-nut">Lưu</button></div>
</form>
</section>
<nav class="ql-khoi sb-lien-quan" aria-label="Liên quan đến bài">
<a href="/GiangVien/CauHoi?bai=@Model.Id"><span>Bài tập của bài</span><small>@ViewBag.SoCau câu</small></a>
<a href="/GiangVien/LichDay/Tao?bai=@Model.Id"><span>Lên lịch buổi dạy online</span><small>+</small></a>
</nav>
</aside>
</div>
@section Scripts {
<script src="~/js/soan-noi-dung.js" asp-append-version="true"></script>
<script src="~/js/nhap-tai-lieu.js" asp-append-version="true"></script>
}
<partial name="_KhungXemTruoc" />
