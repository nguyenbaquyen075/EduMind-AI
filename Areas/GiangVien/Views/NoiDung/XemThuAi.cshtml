@model BanNhapNoiDungAiForm
@{ var bai = (Bai)ViewBag.Bai; var theoVanBan = ViewBag.ChiaTheoVanBan is true; ViewData["Title"] = theoVanBan ? "Xem thử nội dung văn bản" : "Xem thử nội dung AI"; ViewData["TieuDe"] = theoVanBan ? "Xem thử bản chia theo đề mục văn bản" : "Xem thử bản nháp AI"; ViewData["Muc"] = "NoiDung"; }
@if (theoVanBan) { <p class="ql-phu">Đã tách theo ký hiệu đề mục có sẵn, không gọi AI. Anh rà lại cấp mục và nội dung trước khi chia sẻ.</p> }
<p class="ql-phu">Bản này chưa được chia sẻ. Sửa trực tiếp mọi đề mục và nội dung trước khi xác nhận.</p>
<form method="post" asp-action="ChiaSeBanNhapAi" class="ql-form" id="banNhapAi">
<input type="hidden" asp-for="BaiId" />
@for (var i = 0; i < Model.Muc.Count; i++)
{
    var muc = Model.Muc[i];
    var coTieuDeRieng = !string.IsNullOrWhiteSpace(muc.TieuDe) && muc.TieuDe.Trim() != muc.Ten.Trim();
<section class="ql-khoi"><div class="ql-khoi-than ql-form">
<div class="ql-truong"><label asp-for="Muc[i].Ten">Tiêu đề mục @(i + 1)</label><input asp-for="Muc[i].Ten" /></div>
<details open="@coTieuDeRieng">
<summary class="ql-nut-chu">Tiêu đề hiển thị riêng (tuỳ chọn)</summary>
<div class="ql-truong" style="margin-top:8px"><label for="tieuDeMuc_@i">Tiêu đề trên trang đọc</label><input id="tieuDeMuc_@i" type="text" name="Muc[@i].TieuDe" value="@(coTieuDeRieng ? muc.TieuDe : "")" placeholder="Để trống để dùng tiêu đề mục bên trên" /><small>Chỉ điền nếu muốn tên trong mục lục khác tiêu đề trên trang đọc.</small></div>
</details>
@for (var j = 0; j < muc.Phan.Count; j++)
{
    var phan = muc.Phan[j];
    var tieuDeMacDinh = string.IsNullOrWhiteSpace(phan.TieuDe) || phan.TieuDe is "Nội dung" or "Nội dung tài liệu"
        || phan.TieuDe.Trim() == muc.Ten.Trim() || phan.TieuDe.Trim() == muc.TieuDe?.Trim();
    var phanDonGian = muc.Phan.Count == 1 && tieuDeMacDinh;
<div class="@(phanDonGian ? "ql-form" : "ql-the-phan")">
@if (!phanDonGian)
{
<div class="ql-truong"><label asp-for="Muc[i].Phan[j].TieuDe">Tiêu đề phần</label><input asp-for="Muc[i].Phan[j].TieuDe" /></div>
}
<div class="ql-truong"><label asp-for="Muc[i].Phan[j].DoanVan">Nội dung</label><textarea asp-for="Muc[i].Phan[j].DoanVan" rows="6"></textarea></div>
@if (phanDonGian)
{
<details><summary class="ql-nut-chu">Thêm tiêu đề phần (tuỳ chọn)</summary><div class="ql-truong" style="margin-top:8px"><label asp-for="Muc[i].Phan[j].TieuDe">Tiêu đề phần</label><input asp-for="Muc[i].Phan[j].TieuDe" /></div></details>
}
<label class="ql-check"><input asp-for="Muc[i].Phan[j].LaGhiNho" /> Ghi nhớ nhanh</label>
</div>
}
</div></section>
}
<section class="ql-khoi"><div class="ql-khoi-than ql-form"><div class="ql-truong"><label>Chia sẻ cho</label><select asp-for="PhamVi"><option value="KhoaHoc">Khoá học: @bai.ChuDe!.Khoa!.Ten</option><option value="DoiMienPhi">Đội miễn phí</option></select></div><label class="ql-check"><input type="checkbox" name="thayThe" value="true" /> Thay thế toàn bộ mục cũ của bài</label><div class="ql-chan"><button class="ql-nut">Chia sẻ bản đã duyệt</button><a class="ql-nut phu" href="/GiangVien/NoiDung/SoanBai/@Model.BaiId">Huỷ</a></div></div></section>
</form>
@section Scripts {
<script src="~/js/ban-nhap-ai.js" asp-append-version="true"></script>
}
