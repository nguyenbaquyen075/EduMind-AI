@model Khoa?
@{
    ViewData["Title"] = "Nội dung bài học – Giảng viên";
    ViewData["TieuDe"] = "Nội dung bài học";
    ViewData["Muc"] = "NoiDung";
    var dsKhoa = ViewBag.DsKhoa as List<Khoa> ?? [];
}
@if (Model is null)
{
<p class="ql-trong">Bạn chưa được gán khoá nào. Admin gán khoá ở mục Khoá học.</p>
    return;
}
@section Actions {
@if (dsKhoa.Count > 1)
{
<form method="get" class="ql-hang-nut"><div class="ql-truong" style="margin: 0"><select name="khoa" onchange="this.form.submit()" aria-label="Chọn khoá">
@foreach (var k in dsKhoa)
{
<option value="@k.Id" selected="@(k.Id == Model.Id)">@k.Ten</option>
}
</select></div></form>
}
<a href="/Home/KhoaHoc/@Model.Id" class="ql-nut phu" target="_blank">Xem như học viên ↗</a>
<a href="/GiangVien/NoiDung/TaoChuDe?khoa=@Model.Id" class="ql-nut">+ Tạo chủ đề</a>
}

<section class="ql-khoi ql-noi-dung-cay" aria-labelledby="cay">
<div class="ql-khoi-dau"><h2 id="cay">@Model.Ten · chủ đề và bài</h2><p>Bấm "Soạn" để viết nội dung bài. Bài nháp chưa hiện cho học viên.</p></div>
<ul class="ql-cay">
@foreach (var cd in Model.ChuDe.OrderBy(c => c.ThuTu))
{
<li>
<div class="ql-chude">
<span>@cd.Ten</span>
<details class="ql-ba-cham">
<summary aria-label="Thao tác chủ đề @cd.Ten"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="5" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="19" r="2"/></svg></summary>
<ul>
<li><a href="/GiangVien/NoiDung/TaoBai?chuDeId=@cd.Id">Thêm bài học</a></li>
<li><button type="button" data-topic-action="edit" data-id="@cd.Id" data-ten="@cd.Ten">Chỉnh sửa</button></li>
<li><form method="post" asp-action="XoaChuDe" data-hoi="Xoá chủ đề này cùng toàn bộ bài học, mục và nội dung bên trong?"><input type="hidden" name="id" value="@cd.Id"><button class="xoa" type="submit">Xoá</button></form></li>
</ul>
</details>
</div>
    @foreach (var b in cd.Bai.OrderBy(x => x.ThuTu))
    {
<div class="ql-bai-dong">
<span class="ql-bai-so">Bài @b.So</span>
<span>@b.Ten
<span class="ql-phu">@b.Muc.Count mục · @b.CauHoi.Count câu hỏi
@if (!b.DaXuatBan) {<span class="ql-chip vang">Nháp</span>}
@if (b.HocThu) {<span class="ql-chip nhan">Học thử</span>}
</span></span>
<span class="ql-hang-nut"><a href="/GiangVien/NoiDung/SoanBai/@b.Id" class="ql-nut nho">Soạn</a><a href="/GiangVien/CauHoi?bai=@b.Id" class="ql-nut phu nho">Bài tập</a></span>
</div>
    }
</li>
}
</ul>
</section>

<dialog id="chuDeDialog" class="ql-topic-dialog" aria-labelledby="chuDeDialogTitle">
<form method="post" asp-action="SuaChuDe" class="ql-form" id="chuDeDialogForm">
<h2 id="chuDeDialogTitle">Chỉnh sửa chủ đề</h2>
<input type="hidden" name="id" id="chuDeDialogId">
<div class="ql-truong"><label for="chuDeDialogTen">Tên chủ đề</label><input type="text" name="ten" id="chuDeDialogTen" required></div>
<div class="ql-chan"><button class="ql-nut">Lưu thay đổi</button><button type="button" class="ql-nut phu" id="chuDeDialogCancel">Huỷ</button></div>
</form>
</dialog>
@section Scripts {
<script src="~/js/chu-de.js" asp-append-version="true"></script>
}
