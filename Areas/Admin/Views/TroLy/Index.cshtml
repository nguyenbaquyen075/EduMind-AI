@model AdminTroLyViewModel
@{ ViewData["TieuDe"] = "Trợ lý AI & tài liệu"; ViewData["Title"] = "Trợ lý AI – Quản trị"; ViewData["Muc"] = "TroLy"; }
@section Actions { <a href="/Home/HoiAi" class="ql-nut">Mở trang chat ↗</a> }
<section class="ad-welcome"><div><p class="ad-eyebrow">TRẠNG THÁI TRỢ LÝ</p><h2>@(Model.BanXemThu ? "Đang sử dụng bản xem thử" : "Đã kết nối dịch vụ AI")</h2><p>@(Model.BanXemThu ? "Trợ lý hiện trả lời các câu gợi ý. Cần cấu hình kết nối để hỏi tự do theo tài liệu." : "Trợ lý tìm nội dung trong tài liệu khoá học và trả lời kèm nguồn.")</p></div><span class="ql-chip @(Model.BanXemThu ? "vang" : "xanh")">@(Model.BanXemThu ? "Demo" : "Đã cấu hình kết nối")</span></section>
<div class="ad-stats"><article class="ad-stat"><p>Tài liệu nguồn</p><strong>@Model.TaiLieu.Count</strong><small>Tệp tài liệu khoá học</small></article><article class="ad-stat"><p>Mục kiến thức</p><strong>@Model.TaiLieu.Sum(t => t.SoMuc)</strong><small>Trong tài liệu nguồn</small></article><article class="ad-stat"><p>Câu kiểm thử</p><strong>@Model.SoCauKiemThu</strong><small>Bộ câu hỏi kiểm tra chất lượng</small></article><article class="ad-stat"><p>Giới hạn câu hỏi</p><strong>@GioiHanHoiAi.CauHoi.ToString("N0")</strong><small>Ký tự mỗi câu hỏi</small></article></div>
<div class="ad-grid"><section class="ql-khoi"><div class="ql-khoi-dau"><h2>Cấu hình hiện tại</h2><p>Thông tin đang được hệ thống sử dụng</p></div><div class="ql-khoi-than"><dl class="ad-metadata"><div><dt>Đang dùng</dt><dd>@Model.DangDung</dd></div><div><dt>Kiểm tra câu trả lời bằng AI</dt><dd>@(Model.CauHinh.BatAiCham ? "Bật" : "Tắt")</dd></div><div><dt>Số đoạn tài liệu mỗi lượt</dt><dd>@Model.CauHinh.SoDoan</dd></div><div><dt>Hướng dẫn trợ lý</dt><dd>@(Model.CoPrompt ? "Đã có" : "Chưa có")</dd></div><div><dt>Giới hạn hỏi</dt><dd>10 câu / phút / địa chỉ IP</dd></div></dl></div></section><section class="ql-khoi"><div class="ql-khoi-dau"><h2>Nguồn tài liệu của trợ lý</h2><p>Trợ lý đọc trực tiếp nội dung đã nhập trong hệ thống</p></div><div class="ql-khoi-than">
@if (Model.ChiMuc is { } c)
{
<dl class="ad-metadata"><div><dt>Đoạn tài liệu đang dùng</dt><dd>@c.SoDoan</dd></div><div><dt>Từ nội dung đã nhập (@c.SoKhoaCoSoDuLieu khoá, gói học)</dt><dd>@c.SoDoanCoSoDuLieu đoạn</dd></div><div><dt>Trong đó từ Kho tài liệu giảng viên tải lên</dt><dd>@c.SoDoanTaiLieuTaiLen đoạn</dd></div><div><dt>Từ tệp tài liệu (khoá chưa nhập nội dung)</dt><dd>@c.SoDoanTepMd đoạn</dd></div><div><dt>Nạp lần cuối</dt><dd>@c.NapLuc.ToString("HH:mm dd/MM/yyyy")</dd></div></dl>
<p class="ql-phu">Khi giảng viên hoặc quản trị lưu bài, tải tài liệu vào kho, sửa khoá hay gói học, trợ lý tự nạp lại ở câu hỏi kế tiếp. Bài nháp và khoá đang ẩn không được đưa vào.</p>
<form method="post" asp-action="LamMoi"><button class="ql-nut" type="submit">Nạp lại ngay</button></form>
}
else
{
<p>Đang chạy bản xem thử nên chưa đọc nội dung hệ thống. Cấu hình khoá API để trợ lý trả lời theo nội dung đã nhập.</p>
}
</div></section></div>
@if (Model.CanBoSung.Count > 0)
{
<section class="ql-khoi"><div class="ql-khoi-dau"><h2>Dữ liệu cần bổ sung</h2><p>Thiếu các mục này thì trợ lý không trả lời được hoặc trả lời thiếu</p></div><div class="ql-khoi-than"><ul>@foreach (var m in Model.CanBoSung) { <li>@m</li> }</ul></div></section>
}
<section class="ql-khoi"><div class="ql-khoi-dau"><h2>Tệp tài liệu dự phòng</h2><p>Chỉ dùng cho khoá chưa có nội dung trong hệ thống</p></div>@if(Model.TaiLieu.Count == 0) { <p class="ql-trong">Chưa có tài liệu nguồn cho trợ lý.</p> }else { <div class="ad-table-wrap"><table class="ql-bang"><thead><tr><th>Tài liệu</th><th>Môn học</th><th class="so">Bài</th><th class="so">Mục</th><th class="so">Dung lượng</th></tr></thead><tbody>@foreach(var t in Model.TaiLieu) { <tr><td>@t.Ten</td><td>@t.Mon</td><td class="so">@t.SoBai</td><td class="so">@t.SoMuc</td><td class="so">@Math.Ceiling(t.SoByte / 1024d) KB</td></tr> }</tbody></table></div> }</section>
