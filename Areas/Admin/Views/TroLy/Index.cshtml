@model AdminTroLyViewModel
@{ ViewData["TieuDe"] = "Trợ lý AI & tài liệu"; ViewData["Title"] = "Trợ lý AI – Quản trị"; ViewData["Muc"] = "TroLy"; }
@section Actions { <a href="/Home/HoiAi" class="ql-nut">Mở trang chat ↗</a> }
<section class="ad-welcome"><div><p class="ad-eyebrow">TRẠNG THÁI TRỢ LÝ</p><h2>@(Model.BanXemThu ? "Đang sử dụng bản xem thử" : "Đã kết nối dịch vụ AI")</h2><p>@(Model.BanXemThu ? "Trợ lý hiện trả lời các câu gợi ý. Cần cấu hình kết nối để hỏi tự do theo tài liệu." : "Trợ lý tìm nội dung trong tài liệu khoá học và trả lời kèm nguồn.")</p></div><span class="ql-chip @(Model.BanXemThu ? "vang" : "xanh")">@(Model.BanXemThu ? "Demo" : "Đã cấu hình kết nối")</span></section>
<div class="ad-stats"><article class="ad-stat"><p>Tài liệu nguồn</p><strong>@Model.TaiLieu.Count</strong><small>Tệp tài liệu khoá học</small></article><article class="ad-stat"><p>Mục kiến thức</p><strong>@Model.TaiLieu.Sum(t => t.SoMuc)</strong><small>Trong tài liệu nguồn</small></article><article class="ad-stat"><p>Câu kiểm thử</p><strong>@Model.SoCauKiemThu</strong><small>Bộ câu hỏi kiểm tra chất lượng</small></article><article class="ad-stat"><p>Giới hạn câu hỏi</p><strong>@GioiHanHoiAi.CauHoi.ToString("N0")</strong><small>Ký tự mỗi câu hỏi</small></article></div>
<div class="ad-grid"><section class="ql-khoi"><div class="ql-khoi-dau"><h2>Cấu hình hiện tại</h2><p>Thông tin đang được hệ thống sử dụng</p></div><div class="ql-khoi-than"><dl class="ad-metadata"><div><dt>Model trả lời</dt><dd>@Model.CauHinh.ModelTraLoi</dd></div><div><dt>Model hỗ trợ</dt><dd>@Model.CauHinh.ModelPhu</dd></div><div><dt>Kiểm tra câu trả lời bằng AI</dt><dd>@(Model.CauHinh.BatAiCham ? "Bật" : "Tắt")</dd></div><div><dt>Số đoạn tài liệu mỗi lượt</dt><dd>@Model.CauHinh.SoDoan</dd></div><div><dt>Hướng dẫn trợ lý</dt><dd>@(Model.CoPrompt ? "Đã có" : "Chưa có")</dd></div><div><dt>Giới hạn hỏi</dt><dd>10 câu / phút / địa chỉ IP</dd></div></dl></div></section><section class="ql-khoi"><div class="ql-khoi-dau"><h2>Cần kiểm tra trước khi sử dụng</h2></div><div class="ql-khoi-than"><p>Trạng thái kết nối thể hiện việc hệ thống đã được cấu hình, không phải kết quả kiểm tra dịch vụ trực tiếp.</p><p>Tài liệu của trợ lý hiện được quản lý riêng với nội dung bài giảng. Sau khi thay đổi bài học, cần cập nhật tài liệu nguồn tương ứng để câu trả lời theo kịp nội dung.</p><p class="ql-phu">Trang này hiển thị cấu hình hiện tại. Khoá API không hiển thị trên giao diện quản trị.</p></div></section></div>
<section class="ql-khoi"><div class="ql-khoi-dau"><h2>Tài liệu đang có</h2><p>Nguồn kiến thức cho trợ lý</p></div>@if(Model.TaiLieu.Count == 0) { <p class="ql-trong">Chưa có tài liệu nguồn cho trợ lý.</p> }else { <div class="ad-table-wrap"><table class="ql-bang"><thead><tr><th>Tài liệu</th><th>Môn học</th><th class="so">Bài</th><th class="so">Mục</th><th class="so">Dung lượng</th></tr></thead><tbody>@foreach(var t in Model.TaiLieu) { <tr><td>@t.Ten</td><td>@t.Mon</td><td class="so">@t.SoBai</td><td class="so">@t.SoMuc</td><td class="so">@Math.Ceiling(t.SoByte / 1024d) KB</td></tr> }</tbody></table></div> }</section>
