@model AdminBaoCaoViewModel
@{ ViewData["TieuDe"] = "Báo cáo học tập"; ViewData["Title"] = "Báo cáo – Quản trị"; ViewData["Muc"] = "BaoCao"; }
@section Actions { <a asp-action="Xuat" asp-route-tu="@Model.Tu.ToString("yyyy-MM-dd")" asp-route-den="@Model.Den.ToString("yyyy-MM-dd")" asp-route-khoa="@Model.KhoaId" class="ql-nut phu">↓ Xuất CSV</a> }
<div asp-validation-summary="All" class="ql-tong-loi" style="margin-bottom:16px"></div>
<form method="get" class="ad-filters"><div class="ql-truong"><label for="tu">Từ ngày</label><input type="date" id="tu" name="tu" value="@Model.Tu.ToString("yyyy-MM-dd")" required></div><div class="ql-truong"><label for="den">Đến ngày</label><input type="date" id="den" name="den" value="@Model.Den.ToString("yyyy-MM-dd")" required></div><div class="ql-truong"><label for="khoa">Khoá học</label><select id="khoa" name="khoa"><option value="">Toàn hệ thống</option>@foreach(var k in Model.DsKhoa) { <option value="@k.Id" selected="@(k.Id == Model.KhoaId)">@k.Ten</option> }</select></div><button class="ql-nut">Xem báo cáo</button></form>
<p class="ad-filter-note">Dữ liệu bài nộp trong khoảng ngày đã chọn, theo giờ Việt Nam. Tối đa 90 ngày mỗi lần xem.</p>
<div class="ad-stats">@foreach(var s in Model.SoLieu) { <article class="ad-stat"><p>@s.Nhan</p><strong>@s.GiaTri</strong><small>@s.Phu</small></article> }</div>
<section class="ql-khoi"><div class="ql-khoi-dau"><h2>Bài nộp theo ngày</h2><span>@Model.Tu.ToString("dd/MM") – @Model.Den.ToString("dd/MM/yyyy")</span></div><div class="ql-khoi-than"><partial name="_BieuDoAdmin" model="Model.Ngay" /></div></section>
<section class="ql-khoi"><div class="ql-khoi-dau"><h2>Chi tiết theo ngày</h2><p>Tài khoản mới tính trên toàn hệ thống</p></div><div class="ad-table-wrap"><table class="ql-bang"><thead><tr><th>Ngày</th><th class="so">Lượt luyện tập</th><th class="so">Bài tập nộp</th><th class="so">Tổng bài nộp</th><th class="so">Tài khoản mới</th></tr></thead><tbody>@foreach(var n in Model.Ngay) { <tr><td>@n.Ngay.ToString("dd/MM/yyyy")</td><td class="so">@n.LuyenTap</td><td class="so">@n.BaiNop</td><td class="so"><b>@n.Tong</b></td><td class="so">@n.DangKy</td></tr> }</tbody></table></div></section>
<section class="ql-khoi"><div class="ql-khoi-dau"><h2>Tình hình khoá học hiện tại</h2><p>Ghi danh và nội dung tại thời điểm xem, không giới hạn theo khoảng ngày</p></div><div class="ad-table-wrap"><table class="ql-bang"><thead><tr><th>Khoá học</th><th>Giảng viên</th><th class="so">Bài xuất bản</th><th class="so">Tổng ghi danh</th><th class="so">Còn hạn</th></tr></thead><tbody>@foreach(var k in Model.Khoa) { <tr><td>@k.Ten</td><td>@(k.GiangVien ?? "Chưa phân công")</td><td class="so">@k.DaXuatBan / @k.SoBai</td><td class="so">@k.SoHocVien</td><td class="so">@k.DangHoc</td></tr> }</tbody></table></div></section>
