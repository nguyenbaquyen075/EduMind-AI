@model AdminGhiDanhViewModel
@{ ViewData["TieuDe"] = "Ghi danh & hạn học"; ViewData["Title"] = "Ghi danh – Quản trị"; ViewData["Muc"] = "GhiDanh"; var now = DateTime.UtcNow; }
@section Actions { <a href="/Admin/NguoiDung/Tao" class="ql-nut phu">+ Tạo học viên</a> }
<div class="ad-stats ad-stats--3"><article class="ad-stat"><p>Ghi danh còn hạn</p><strong>@Model.DangHoc</strong><small>Toàn hệ thống</small></article><article class="ad-stat"><p>Sắp hết hạn</p><strong>@Model.SapHetHan</strong><small>Trong 14 ngày tới</small></article><article class="ad-stat"><p>Đã hết hạn</p><strong>@Model.HetHan</strong><small>Cần kiểm tra hoặc gia hạn</small></article></div>
<section class="ql-khoi"><div class="ql-khoi-dau"><h2>+ Ghi danh học viên</h2><p>Học viên được mở toàn bộ bài của khoá</p></div><form method="post" asp-controller="KhoaHoc" asp-action="ThemGhiDanh" class="ad-filters" style="border:0;margin:0"><div class="ql-truong"><label for="gdEmail">Email học viên</label><input id="gdEmail" type="email" name="email" required placeholder="hocvien@email.com"></div><div class="ql-truong"><label for="gdKhoa">Khoá học</label><select id="gdKhoa" name="id" required><option value="">— Chọn khoá —</option>@foreach (var k in Model.DsKhoa) { <option value="@k.Id">@k.Ten</option> }</select></div><div class="ql-truong"><label for="gdHan">Hạn học</label><input id="gdHan" type="date" name="hanDen"><small>Để trống: không giới hạn</small></div><button class="ql-nut">Ghi danh</button></form></section>
<form method="get" class="ad-filters"><div class="ql-truong"><label for="q">Tìm học viên</label><input id="q" type="text" name="q" value="@Model.Q" placeholder="Họ tên hoặc email"></div><div class="ql-truong"><label for="khoa">Khoá học</label><select id="khoa" name="khoa"><option value="">Tất cả khoá</option>@foreach(var k in Model.DsKhoa) { <option value="@k.Id" selected="@(k.Id == Model.KhoaId)">@k.Ten</option> }</select></div><div class="ql-truong"><label for="trangThai">Trạng thái</label><select id="trangThai" name="trangThai"><option value="">Tất cả</option><option value="con-han" selected="@(Model.TrangThai == "con-han")">Còn hạn</option><option value="sap-het" selected="@(Model.TrangThai == "sap-het")">Sắp hết hạn</option><option value="het-han" selected="@(Model.TrangThai == "het-han")">Đã hết hạn</option></select></div><button class="ql-nut phu">Lọc</button><a href="/Admin/GhiDanh" class="ql-nut-chu">Bỏ lọc</a></form>
<section class="ql-khoi"><div class="ql-khoi-dau"><h2>Danh sách ghi danh</h2><span>@Model.Tong kết quả</span></div>
@if (Model.Ds.Count == 0) { <p class="ql-trong">Không có ghi danh phù hợp với bộ lọc.</p> }
else { <div class="ad-table-wrap"><table class="ql-bang"><thead><tr><th>Học viên</th><th>Khoá học</th><th>Ngày ghi danh</th><th>Hạn học</th><th>Trạng thái</th><th></th></tr></thead><tbody>
@foreach (var g in Model.Ds) { <tr><td><a href="/Admin/NguoiDung/ChiTiet/@g.NguoiDungId"><b>@g.HoTen</b></a><span class="ql-phu">@g.Email</span></td><td>@g.Khoa</td><td>@g.NgayTao.ToLocalTime().ToString("dd/MM/yyyy")</td><td>@(g.HanDen?.ToLocalTime().ToString("dd/MM/yyyy") ?? "Không giới hạn")</td><td><span class="ql-chip @(g.HanDen < now ? "do" : g.HanDen <= now.AddDays(14) ? "vang" : "xanh")">@(g.HanDen < now ? "Đã hết hạn" : g.HanDen <= now.AddDays(14) ? "Sắp hết hạn" : "Còn hạn")</span></td><td><a href="/Admin/KhoaHoc/GhiDanh/@g.KhoaId" class="ql-nut phu nho">Gia hạn / quản lý</a></td></tr> }
</tbody></table></div> }
</section>
<div class="ad-pagination"><span>Trang @Model.Trang / @Model.SoTrang · tối đa 25 ghi danh mỗi trang</span><span class="ql-hang-nut">@if(Model.Trang > 1) { <a asp-action="Index" asp-route-q="@Model.Q" asp-route-khoa="@Model.KhoaId" asp-route-trangThai="@Model.TrangThai" asp-route-trang="@(Model.Trang - 1)" class="ql-nut phu nho">← Trước</a> } @if(Model.Trang < Model.SoTrang) { <a asp-action="Index" asp-route-q="@Model.Q" asp-route-khoa="@Model.KhoaId" asp-route-trangThai="@Model.TrangThai" asp-route-trang="@(Model.Trang + 1)" class="ql-nut phu nho">Sau →</a> }</span></div>
