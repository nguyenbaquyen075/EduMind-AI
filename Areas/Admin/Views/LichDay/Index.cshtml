@model List<AdminBuoi>
@{
    ViewData["TieuDe"] = "Lịch dạy"; ViewData["Title"] = "Lịch dạy – Quản trị"; ViewData["Muc"] = "LichDay";
    string gv = ViewBag.Gv; string? khoa = ViewBag.KhoaId; string? tt = ViewBag.TrangThai;
    var goc = $"/Admin/LichDay?gv={gv}" + (khoa is null ? "" : $"&khoa={khoa}");
    var mg = SuDia.Web.Services.AdminThongKeService.MuiGio;
    var vi = new System.Globalization.CultureInfo("vi-VN");
    var homNay = SuDia.Web.Services.AdminThongKeService.HomNay;
    var tabs = new (string Ma, string Ten, int So)[] { ("sap-toi", "Sắp tới", (int)ViewBag.SapToi), ("da-qua", "Đã qua", (int)ViewBag.DaQua), ("chua-dat", "Chưa đặt giờ", (int)ViewBag.ChuaDat), ("tat-ca", "Tất cả", (int)ViewBag.TatCa) };
    var nhom = Model.GroupBy(b => b.Luc is DateTime l ? TimeZoneInfo.ConvertTimeFromUtc(l, mg).Date : (DateTime?)null).ToList();
    string TenNgay(DateTime? d) => d is null ? "Chưa đặt giờ" : d == homNay ? "Hôm nay · " + d.Value.ToString("dd/MM", vi) : d == homNay.AddDays(1) ? "Ngày mai · " + d.Value.ToString("dd/MM", vi) : vi.TextInfo.ToTitleCase(d.Value.ToString("dddd, dd/MM/yyyy", vi));
}
<partial name="_DauGiangVien" />
<section class="ql-khoi">
<div class="bt-dau">
<nav class="gd-tab" aria-label="Thời gian">
@foreach (var t in tabs)
{
<a href="@goc&trangThai=@t.Ma" aria-current="@(t.Ma == (tt ?? "sap-toi") ? "page" : null)">@t.Ten <span class="bt-dem">@t.So</span></a>
}
</nav>
<span class="ql-phu">Giờ Việt Nam</span>
</div>
@if (Model.Count == 0)
{
<div class="ad-empty"><b>Chưa có buổi học</b><p>Giảng viên đặt lịch ở trang Giảng viên › Lịch dạy online.</p></div>
}
else
{
<div class="ld-ds">
@foreach (var n in nhom)
{
<h3 class="ld-ngay">@TenNgay(n.Key)</h3>
<ul>
@foreach (var b in n)
{
    var gio = b.Luc is DateTime l ? TimeZoneInfo.ConvertTimeFromUtc(l, mg) : (DateTime?)null;
    var qua = b.Luc < DateTime.UtcNow;
<li class="ld-buoi @(qua ? "qua" : null)">
<span class="ld-gio">@(gio?.ToString("HH:mm") ?? "--:--")</span>
<span class="ld-noi-dung"><b>@b.Bai</b><small>@b.Khoa</small></span>
@if (!qua && Uri.TryCreate(b.Link, UriKind.Absolute, out var url) && url.Scheme == "https") { <a href="@b.Link" target="_blank" rel="noopener noreferrer" class="ql-nut phu nho">Vào lớp ↗</a> }
else if (!qua && b.Luc is not null) { <span class="ql-chip vang">Chưa có link</span> }
else if (qua) { <span class="ql-chip">Đã qua</span> }
</li>
}
</ul>
}
</div>
}
</section>
