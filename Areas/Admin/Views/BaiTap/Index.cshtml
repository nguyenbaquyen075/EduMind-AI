@model List<AdminBaiTapRow>
@{
    ViewData["TieuDe"] = "Bài tập & bài nộp"; ViewData["Title"] = "Bài tập – Quản trị"; ViewData["Muc"] = "BaiTap";
    string gv = ViewBag.Gv; string? khoa = ViewBag.KhoaId; string? tt = ViewBag.TrangThai; string? q = ViewBag.Q;
    var goc = $"/Admin/BaiTap?gv={gv}" + (khoa is null ? "" : $"&khoa={khoa}") + (string.IsNullOrEmpty(q) ? "" : $"&q={Uri.EscapeDataString(q)}");
    var now = DateTime.UtcNow;
    var tiLe = (List<AdminTiLeKhoa>)ViewBag.TiLe;
    var motKhoa = tiLe.Count == 1 ? tiLe[0] : null;
    var tabs = new (string? Ma, string Ten, int So)[] { (null, "Tất cả", (int)ViewBag.TatCa), ("da-giao", "Đã giao", (int)ViewBag.DaGiao), ("cho-cham", "Có bài chờ chấm", (int)ViewBag.ChoCham), ("nhap", "Nháp", (int)ViewBag.Nhap) };
}
<partial name="_DauGiangVien" />
@if (tiLe.Count > 1) { <partial name="_BieuDoHoanThanh" model="tiLe" /> }
<section class="ql-khoi">
<div class="bt-dau">
<nav class="gd-tab" aria-label="Trạng thái bài tập">
@foreach (var t in tabs)
{
<a href="@goc@(t.Ma is null ? "" : "&trangThai=" + t.Ma)" aria-current="@(t.Ma == tt ? "page" : null)">@t.Ten <span class="bt-dem">@t.So</span></a>
}
</nav>
@if (motKhoa?.PhanTram is int ht) { <span class="bt-ht" title="@motKhoa.DaNop/@motKhoa.CanNop bài cần nộp đã nộp">Hoàn thành <b>@ht%</b></span> }
<form method="get" class="bt-tim" role="search"><input type="hidden" name="gv" value="@gv"><input type="hidden" name="khoa" value="@khoa"><input type="hidden" name="trangThai" value="@tt">
<input type="search" name="q" value="@q" placeholder="Tìm bài tập hoặc bài học" aria-label="Tìm bài tập"></form>
</div>
@if (Model.Count == 0)
{
<div class="ad-empty"><b>Chưa có bài tập phù hợp</b><p>Giảng viên giao bài ở trang Giảng viên › Giao bài tập.</p></div>
}
else
{
<div class="ad-table-wrap"><table class="ql-bang">
<thead><tr><th>Bài tập</th><th>Khoá</th><th>Hạn nộp</th><th>Đã nộp</th><th class="so">Chờ chấm</th><th></th></tr></thead>
<tbody>
@foreach (var b in Model)
{
    var pt = b.SoHocVien == 0 ? (int?)null : Math.Min(100, b.SoNop * 100 / b.SoHocVien);
<tr><td><b>@b.Ten</b>@if (!b.DaGiao) { <span class="ql-chip vang">Nháp</span> }<span class="ad-cell-note">@b.Bai</span></td>
<td>@b.Khoa</td>
<td>@if (b.HanNop is DateTime han) { <span class="@(han < now ? "ql-phu" : null)">@han.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>@if (han < now) { <span class="ql-phu">Đã hết hạn</span> } } else { <span class="ql-phu">Không hạn</span> }</td>
<td>@if (b.DaGiao && pt is int p) { <div class="gv-tl"><span class="bd-ht-ray"><span class="bd-ht-thanh" style="width:@(Math.Max(p, 1))%"></span></span><b>@b.SoNop/@b.SoHocVien</b></div> } else { <span class="ql-phu">@(b.DaGiao ? $"{b.SoNop} bài" : "—")</span> }</td>
<td class="so">@if (b.ChoCham > 0) { <span class="ql-chip vang">@b.ChoCham</span> } else { <span>0</span> }</td>
<td class="hanh-dong"><a href="/GiangVien/GiaoBai/BaiNop/@b.Id" class="ql-nut phu nho">Xem bài nộp</a></td></tr>
}
</tbody></table></div>
<p class="bt-chan">@ViewBag.Tong bài tập · tối đa 200</p>
}
</section>
