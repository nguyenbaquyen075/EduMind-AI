@model List<AdminBaiTapRow>
@{ ViewData["TieuDe"] = "Bài tập & bài nộp"; ViewData["Title"] = "Bài tập – Quản trị"; ViewData["Muc"] = "BaiTap"; string? khoa = ViewBag.KhoaId; string? tt = ViewBag.TrangThai; }
@section Actions { <a href="/GiangVien/DeThi" class="ql-nut phu">Đề thi thử</a><a href="/GiangVien/GiaoBai/Tao" class="ql-nut">+ Giao bài tập</a> }
<div class="ql-so-lieu"><div class="ql-the"><p>Bài tập đã giao</p><b>@ViewBag.DaGiao</b></div><div class="ql-the"><p>Bài tập nháp</p><b>@ViewBag.Nhap</b></div><div class="ql-the"><p>Bài nộp chờ chấm</p><b>@ViewBag.ChoCham</b></div></div>
<form method="get" class="ad-filters"><div class="ql-truong"><label for="q">Tìm bài tập</label><input id="q" type="text" name="q" value="@ViewBag.Q" placeholder="Tên bài tập hoặc bài học"></div><div class="ql-truong"><label for="khoa">Khoá học</label><select id="khoa" name="khoa"><option value="">Tất cả khoá</option>@foreach(Khoa k in ViewBag.DsKhoa) { <option value="@k.Id" selected="@(k.Id == khoa)">@k.Ten</option> }</select></div><div class="ql-truong"><label for="tt">Trạng thái</label><select id="tt" name="trangThai"><option value="">Tất cả</option><option value="da-giao" selected="@(tt == "da-giao")">Đã giao</option><option value="nhap" selected="@(tt == "nhap")">Nháp</option><option value="cho-cham" selected="@(tt == "cho-cham")">Có bài nộp chờ chấm</option></select></div><button class="ql-nut phu">Lọc</button><a href="/Admin/BaiTap" class="ql-nut-chu">Bỏ lọc</a></form>
<section class="ql-khoi"><div class="ql-khoi-dau"><h2>Bài tập theo buổi</h2><span>@ViewBag.Tong kết quả · hiển thị tối đa 200 bài</span></div>
@if(Model.Count == 0) { <div class="ad-empty"><b>Chưa có bài tập phù hợp</b><p>Giao bài tập cho một buổi học hoặc thay đổi bộ lọc để xem bài đã tạo.</p><a href="/GiangVien/GiaoBai/Tao" class="ql-nut phu">+ Giao bài tập</a></div> }
else { <div class="ad-table-wrap"><table class="ql-bang"><thead><tr><th>Bài tập</th><th>Khoá học</th><th>Trạng thái</th><th class="so">Bài nộp</th><th class="so">Chờ chấm</th><th></th></tr></thead><tbody>
@foreach(var b in Model) { <tr><td><b>@b.Ten</b><span class="ad-cell-note">@b.Bai · @(b.HanNop is DateTime han ? $"Hạn {han.ToLocalTime():dd/MM/yyyy HH:mm}" : "Không hạn nộp")</span></td><td>@b.Khoa</td><td><span class="ql-chip @(b.DaGiao ? "xanh" : "vang")">@(b.DaGiao ? "Đã giao" : "Nháp")</span></td><td class="so">@b.SoNop</td><td class="so">@b.ChoCham</td><td><div class="ql-hang-nut"><a href="/GiangVien/GiaoBai/BaiNop/@b.Id" class="ql-nut nho">Xem / chấm</a><a href="/GiangVien/GiaoBai/Sua/@b.Id" class="ql-nut phu nho">Nội dung</a></div></td></tr> }
</tbody></table></div> }
</section>
