@model SuaNguoiDungForm
@{ ViewData["TieuDe"] = "Sửa thông tin người dùng"; ViewData["Title"] = "Sửa người dùng – Quản trị"; ViewData["Muc"] = "NguoiDung"; }
<form method="post" class="ql-form ql-khoi ql-khoi-than"><input type="hidden" asp-for="Id"><div asp-validation-summary="ModelOnly" class="ql-tong-loi"></div><div class="ql-truong"><label asp-for="HoTen">Họ tên</label><input asp-for="HoTen" type="text" maxlength="150" required><span asp-validation-for="HoTen" class="ql-loi"></span></div><div class="ql-truong"><label asp-for="Email">Email đăng nhập</label><input asp-for="Email" type="email" required><span asp-validation-for="Email" class="ql-loi"></span><small>Đổi email sẽ yêu cầu người dùng đăng nhập lại.</small></div><div class="ql-chan"><button class="ql-nut">Lưu thông tin</button><a href="/Admin/NguoiDung/ChiTiet/@Model.Id" class="ql-nut phu">Huỷ</a></div></form>
