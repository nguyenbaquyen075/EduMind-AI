@using SuDia.Web.Areas.Admin.Controllers
@model AdminNguoiDungViewModel
@{ var nd = Model.NguoiDung; ViewData["TieuDe"] = "Chi tiết người dùng"; ViewData["Title"] = nd.HoTen + " – Quản trị"; ViewData["Muc"] = "NguoiDung"; }
@section Actions { <a href="/Admin/NguoiDung" class="ql-nut phu">Về danh sách</a><a href="/Admin/NguoiDung/Sua/@nd.Id" class="ql-nut">Sửa thông tin</a> }
<section class="ad-profile"><span class="ad-avatar">@nd.HoTen[..Math.Min(nd.HoTen.Length,1)]</span><div><h2>@nd.HoTen</h2><p>@nd.Email</p><div class="ad-state">@foreach(var r in Model.VaiTro) { <span class="ql-chip nhan">@AdminControllerBase.TenVaiTro(r)</span> }<span class="ql-chip @(nd.LockoutEnd > DateTimeOffset.UtcNow ? "do" : "xanh")">@(nd.LockoutEnd > DateTimeOffset.UtcNow ? "Tài khoản đã khoá" : "Đang hoạt động")</span><span class="ql-phu">Tạo ngày @nd.NgayTao.ToLocalTime().ToString("dd/MM/yyyy")</span></div></div></section>
<div class="ad-stats"><article class="ad-stat"><p>Khoá ghi danh</p><strong>@Model.GhiDanh.Count</strong></article><article class="ad-stat"><p>Bài đã học</p><strong>@Model.BaiDaHoc</strong></article><article class="ad-stat"><p>Lượt luyện tập</p><strong>@Model.TongLuyenTap</strong></article><article class="ad-stat"><p>Bài tập đã nộp</p><strong>@Model.TongBaiNop</strong></article></div>
<section class="ql-khoi"><div class="ql-khoi-dau"><h2>Khoá đã ghi danh</h2><a href="/Admin/GhiDanh" class="ql-nut-chu">Quản lý ghi danh →</a></div>@if(Model.GhiDanh.Count == 0) { <p class="ql-trong">Chưa ghi danh khoá học nào.</p> }else { <div class="ad-table-wrap"><table class="ql-bang"><thead><tr><th>Khoá học</th><th>Ngày ghi danh</th><th>Hạn học</th><th></th></tr></thead><tbody>@foreach(var g in Model.GhiDanh) { <tr><td>@g.Khoa</td><td>@g.NgayTao.ToLocalTime().ToString("dd/MM/yyyy")</td><td>@(g.HanDen?.ToLocalTime().ToString("dd/MM/yyyy") ?? "Không giới hạn")</td><td><a href="/Admin/KhoaHoc/GhiDanh/@g.KhoaId">Quản lý →</a></td></tr> }</tbody></table></div> }</section>
<section class="ql-khoi"><div class="ql-khoi-dau"><h2>Luyện tập gần đây</h2><span>Tối đa 20 lượt mới nhất</span></div>@if(Model.LuyenTap.Count == 0) { <p class="ql-trong">Chưa có bài luyện tập.</p> }else { <div class="ad-table-wrap"><table class="ql-bang"><thead><tr><th>Bài / đề</th><th>Loại</th><th class="so">Câu đúng</th><th>Thời gian nộp</th></tr></thead><tbody>@foreach(var b in Model.LuyenTap) { <tr><td>@b.TenDe</td><td>@(b.LaDeThi ? "Đề thi thử" : "Luyện tập")</td><td class="so">@b.SoDung / @b.SoCau</td><td>@b.NopLuc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td></tr> }</tbody></table></div> }</section>
<section class="ql-khoi"><div class="ql-khoi-dau"><h2>Bài tập theo buổi đã nộp</h2><span>Tối đa 20 bài mới nhất</span></div>@if(Model.BaiNop.Count == 0) { <p class="ql-trong">Chưa nộp bài tập theo buổi.</p> }else { <div class="ad-table-wrap"><table class="ql-bang"><thead><tr><th>Bài tập</th><th>Điểm</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var b in Model.BaiNop) { <tr><td>@b.BaiTapGiao!.Ten<span class="ql-phu">@b.NopLuc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></td><td>@(b.DiemTuLuan is null ? $"{b.DiemTuDong} điểm tự động" : $"{b.DiemTuDong + b.DiemTuLuan} điểm")</td><td><span class="ql-chip @(b.DiemTuLuan is null ? "vang" : "xanh")">@(b.DiemTuLuan is null ? "Chờ chấm tự luận" : "Đã chấm")</span></td><td><a href="/GiangVien/GiaoBai/BaiNop/@b.BaiTapGiaoId">Xem / chấm bài →</a></td></tr> }</tbody></table></div> }</section>
