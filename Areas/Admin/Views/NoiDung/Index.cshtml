@model List<AdminNoiDungRow>
@{ ViewData["TieuDe"] = "Nội dung bài học"; ViewData["Title"] = "Nội dung – Quản trị"; ViewData["Muc"] = "NoiDung"; string? khoa = ViewBag.KhoaId; string? tt = ViewBag.TrangThai; }
@section Actions { <a href="/GiangVien/NoiDung" class="ql-nut">+ Soạn nội dung</a> }
<div class="ql-so-lieu"><div class="ql-the"><p>Đã xuất bản</p><b>@ViewBag.XuatBan</b></div><div class="ql-the"><p>Bài nháp</p><b>@ViewBag.Nhap</b></div><div class="ql-the"><p>Chưa có nội dung</p><b>@ViewBag.Thieu</b></div></div>
<form method="get" class="ad-filters"><div class="ql-truong"><label for="q">Tìm bài / chủ đề</label><input id="q" type="text" name="q" value="@ViewBag.Q" placeholder="Tên bài hoặc chủ đề"></div><div class="ql-truong"><label for="khoa">Khoá học</label><select id="khoa" name="khoa"><option value="">Tất cả khoá</option>@foreach(Khoa k in ViewBag.DsKhoa) { <option value="@k.Id" selected="@(k.Id == khoa)">@k.Ten</option> }</select></div><div class="ql-truong"><label for="tt">Trạng thái</label><select id="tt" name="trangThai"><option value="">Tất cả</option><option value="xuat-ban" selected="@(tt == "xuat-ban")">Đã xuất bản</option><option value="nhap" selected="@(tt == "nhap")">Bài nháp</option><option value="thieu-noi-dung-xuat-ban" selected="@(tt == "thieu-noi-dung-xuat-ban")">Đã xuất bản nhưng thiếu nội dung</option><option value="thieu-noi-dung" selected="@(tt == "thieu-noi-dung")">Chưa có nội dung</option></select></div><button class="ql-nut phu">Lọc</button><a href="/Admin/NoiDung" class="ql-nut-chu">Bỏ lọc</a></form>
<section class="ql-khoi"><div class="ql-khoi-dau"><h2>Bài học trên toàn hệ thống</h2><span>@ViewBag.Tong kết quả · hiển thị tối đa 200 bài</span></div>
@if(Model.Count == 0) { <p class="ql-trong">Không có bài học phù hợp. Tạo chủ đề và bài mới trong Soạn nội dung.</p> }
else { <div class="ad-table-wrap"><table class="ql-bang"><thead><tr><th>Bài học</th><th>Khoá / chủ đề</th><th>Nội dung</th><th>Trạng thái</th><th></th></tr></thead><tbody>
@foreach(var b in Model) { <tr><td><a href="/GiangVien/NoiDung/SoanBai/@b.Id"><b>Bài @b.So. @b.Ten</b></a><span class="ql-phu">@b.SoCau câu luyện tập · @b.SoBaiTap bài tập theo buổi</span></td><td>@b.Khoa<span class="ad-cell-note">@b.ChuDe</span></td><td>@b.SoMuc mục</td><td><div class="ad-state"><span class="ql-chip @(b.XuatBan ? "xanh" : "vang")">@(b.XuatBan ? "Xuất bản" : "Nháp")</span>@if(b.HocThu) { <span class="ql-chip nhan">Học thử</span> }</div></td><td><div class="ql-hang-nut"><a href="/GiangVien/NoiDung/SoanBai/@b.Id" class="ql-nut phu nho">Soạn bài</a><a href="/GiangVien/CauHoi?bai=@b.Id" class="ql-nut phu nho">Bài tập</a></div></td></tr> }
</tbody></table></div> }
</section>
