@model SuDia.Web.Areas.Admin.Controllers.AdminThongBaoViewModel
@using SuDia.Web.Services
@{ ViewData["TieuDe"] = "Thông báo & duyệt đơn"; ViewData["Title"] = "Thông báo – Quản trị"; ViewData["Muc"] = "ThongBao"; }
<section class="ql-khoi"><div class="ql-khoi-dau"><h2>Thông báo</h2><span>200 bản ghi mới nhất</span></div><div class="ad-table-wrap"><table class="ql-bang"><thead><tr><th>Đơn</th><th>Kênh</th><th>Người nhận</th><th>Trạng thái</th><th>Lỗi</th><th></th></tr></thead><tbody>@foreach(var t in Model.ThongBao){<tr><td>@t.DonHang?.MaThanhToan</td><td>@t.Kenh</td><td>@(t.Kenh == KenhThongBao.Sms ? SoDienThoai.Che(t.NguoiNhan) : t.NguoiNhan)</td><td>@t.TrangThai@(t.MaNhaCungCap == "development-log" ? " (giả lập)" : "")</td><td>@t.LoiCuoi</td><td>@if(t.TrangThai==TrangThaiThongBao.Loi){<form method="post" asp-action="GuiLai"><input type="hidden" name="id" value="@t.Id"><button class="ql-nut phu nho">Gửi lại</button></form>}</td></tr>}@if(!Model.ThongBao.Any()){<tr><td colspan="6" class="ql-trong">Chưa có thông báo.</td></tr>}</tbody></table></div></section>
<section class="ql-khoi"><div class="ql-khoi-dau"><h2>Nhật ký duyệt</h2><span>Ưu tiên các dòng cần xem xét</span></div><div class="ad-table-wrap"><table class="ql-bang"><thead><tr><th>Thời điểm</th><th>Đơn</th><th>Quyết định</th><th>Lý do</th></tr></thead><tbody>@foreach(var n in Model.NhatKy){<tr><td>@DinhDang.GioNgay(n.ThoiDiem.ToLocalTime())</td><td>@n.DonHang?.MaThanhToan</td><td>@n.QuyetDinh</td><td>@n.LyDo</td></tr>}@if(!Model.NhatKy.Any()){<tr><td colspan="4" class="ql-trong">Chưa có nhật ký.</td></tr>}</tbody></table></div></section>
