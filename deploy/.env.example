# Sao chép thành .env rồi điền. KHÔNG đưa tệp .env lên GitHub.

# Tên miền đã trỏ bản ghi A về IP máy chủ (ví dụ sudia.vn hoặc hoc.sudia.vn)
TEN_MIEN=sudia.vn

# Mật khẩu CSDL: chuỗi ngẫu nhiên dài, tạo bằng: openssl rand -hex 24
POSTGRES_PASSWORD=

# Trợ lý AI (Anthropic) và AI soạn bài (Gemini)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Thanh toán PayOS (my.payos.vn → Kênh thanh toán → Thông tin tích hợp)
PayOS__ClientId=
PayOS__ApiKey=
PayOS__ChecksumKey=

# Kho tệp tài liệu: để CucBo thì lưu trên ổ máy chủ (volume du-lieu-web); dùng R2 / B2 thì đặt S3 và điền bên dưới
KhoTaiLieu__NoiLuu=CucBo
KhoTaiLieu__S3__DiaChi=
KhoTaiLieu__S3__Bucket=
KhoTaiLieu__S3__Vung=auto
KhoTaiLieu__S3__AccessKey=
KhoTaiLieu__S3__SecretKey=
