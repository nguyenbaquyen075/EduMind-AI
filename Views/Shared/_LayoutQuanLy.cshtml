@using Microsoft.AspNetCore.Identity
@inject UserManager<NguoiDung> Users
@{
    Layout = "_Layout";
    // Khung chung trang Giảng viên / Admin: thanh trên (tiêu đề + nút thao tác), menu trái theo vai trò
    var khu = ViewData["Khu"] as string ?? "GiangVien";
    var muc = ViewData["Muc"] as string ?? "";
    var nd = await Users.GetUserAsync(User);
    var laAdmin = User.IsInRole(VaiTro.Admin);
    var menu = khu == "Admin"
        ? new (string Nhom, string Ma, string Ten, string? Link, string Icon)[]
        {
            ("", "TongQuan", "Tổng quan", "/Admin", "M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z"),
            ("Vận hành", "NguoiDung", "Người dùng", "/Admin/NguoiDung", "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8M22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"),
            ("Vận hành", "KhoaHoc", "Khoá học", "/Admin/KhoaHoc", "M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2zM22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z"),
            ("Vận hành", "GhiDanh", "Ghi danh & hạn học", "/Admin/GhiDanh", "M9 11l3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"),
            ("Đào tạo", "NoiDung", "Nội dung bài học", "/Admin/NoiDung", "M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"),
            ("Đào tạo", "BaiTap", "Bài tập & bài nộp", "/Admin/BaiTap", "M9 3h6v4H9zM5 5h14v16H5zM9 12h6M9 16h4"),
            ("Đào tạo", "LichDay", "Lịch dạy toàn hệ thống", "/Admin/LichDay", "M3 5h18v16H3zM7 3v4M17 3v4M3 10h18"),
            ("Theo dõi", "BaoCao", "Báo cáo học tập", "/Admin/BaoCao", "M3 3v18h18M7 16v-5M12 16V7M17 16V4"),
            ("Theo dõi", "TroLy", "Trợ lý AI & tài liệu", "/Admin/TroLy", "M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"),
        }
        : new (string Nhom, string Ma, string Ten, string? Link, string Icon)[]
        {
            ("", "TongQuan", "Bàn làm việc", "/GiangVien", "M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z"),
            ("Soạn cho học viên", "NoiDung", "Nội dung bài học", "/GiangVien/NoiDung", "M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"),
            ("Soạn cho học viên", "GiaoBai", "Giao bài tập", "/GiangVien/GiaoBai/Tao", "M12 8v8M8 12h8M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"),
            ("Soạn cho học viên", "CauHoi", "Bài tập", "/GiangVien/CauHoi", "M9 11l3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"),
            ("Soạn cho học viên", "DeThi", "Đề thi thử", "/GiangVien/DeThi", "M12 21a8 8 0 1 0 0-16 8 8 0 0 0 0 16zM12 9v4l2 2M9 2h6"),
            ("Soạn cho học viên", "LichDay", "Lịch dạy online", "/GiangVien/LichDay", "M2 6h14v12H2zM16 10l6-3v10l-6-3z"),
            ("Theo dõi", "HocVien", "Học viên", "/GiangVien/HocVien", "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8"),
        };
    string? nhomTruoc = null;
}
@section Head {
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
@* Hiện ngay bằng font hệ thống; không chờ mạng Google Fonts khi chuyển menu. *@
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" media="print" onload="this.media='all'">
<link rel="stylesheet" href="~/css/quan-ly.css" asp-append-version="true">
@if (khu == "Admin") { <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true"> }
@await RenderSectionAsync("Head", required: false)
}
<div class="ql ql--@(khu == "Admin" ? "admin" : "gv")">
<aside class="ql-side" aria-label="Menu @(khu == "Admin" ? "quản trị" : "giảng viên")">
<a href="@(khu == "Admin" ? "/Admin" : "/GiangVien")" class="ql-logo"><b>Sử<span>·</span>Địa</b><em>@(khu == "Admin" ? "Quản trị" : "Giảng viên")</em></a>
<nav>
@foreach (var m in menu)
{
    if (m.Nhom != nhomTruoc && m.Nhom != "")
    {
<p class="ql-nhom">@m.Nhom</p>
    }
    nhomTruoc = m.Nhom;
    if (m.Link is null)
    {
<span class="ql-link tat" aria-disabled="true"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="@m.Icon"></path></svg>@m.Ten</span>
    }
    else
    {
<a href="@m.Link" class="ql-link @(m.Ma == muc ? "dang-mo" : null)" aria-current="@(m.Ma == muc ? "page" : null)"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="@m.Icon"></path></svg>@m.Ten</a>
    }
}
</nav>
@if (laAdmin)
{
<a href="@(khu == "Admin" ? "/GiangVien" : "/Admin")" class="ql-chuyen">@(khu == "Admin" ? "Sang trang giảng viên" : "Sang trang quản trị") →</a>
}
<a href="/Home/KhoaHoc" class="ql-chuyen">Xem như học viên →</a>
</aside>

<div class="ql-than">
<header class="ql-top">
<div class="ql-top-trai">
@if (ViewData["Crumb"] is string crumb)
{
<p class="ql-crumb">@Html.Raw(crumb)</p>
}
<h1>@ViewData["TieuDe"]</h1>
</div>
<div class="ql-top-phai">
@await RenderSectionAsync("Actions", required: false)
<span class="ql-nguoi" title="@nd?.Email"><span class="ql-avatar" aria-hidden="true">@((nd?.HoTen ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries).LastOrDefault()?[..1].ToUpper())</span>@nd?.HoTen</span>
<form method="post" asp-area="" asp-controller="TaiKhoan" asp-action="DangXuat"><button type="submit" class="ql-nut phu nho">Đăng xuất</button></form>
</div>
</header>
@if (TempData["ThongBao"] is string tb)
{
<p class="ql-thong-bao" role="status">@tb</p>
}
@if (TempData["Loi"] is string loi)
{
<p class="ql-thong-bao loi" role="alert">@loi</p>
}
<main class="ql-main">
@RenderBody()
</main>
</div>
</div>
@section Scripts {
<script>
// Nút xoá: hỏi lại trước khi gửi
document.querySelectorAll('form[data-hoi]').forEach((f) => f.addEventListener('submit', (e) => { if (!confirm(f.dataset.hoi)) e.preventDefault(); }));
// Menu ⋮: bấm ra ngoài hoặc Esc thì đóng
document.addEventListener('click', (e) => document.querySelectorAll('details.ql-ba-cham[open]').forEach((d) => { if (!d.contains(e.target)) d.open = false; }));
document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const d = document.querySelector('details.ql-ba-cham[open]');
    if (d) { d.open = false; d.querySelector('summary').focus(); }
});
</script>
@await RenderSectionAsync("Scripts", required: false)
}
