@using Microsoft.AspNetCore.Identity
@inject UserManager<NguoiDung> Users
@{
    Layout = "_Layout";
    // Khung chung trang Giảng viên / Admin: thanh trên (tiêu đề + nút thao tác), menu trái theo vai trò
    var khu = ViewData["Khu"] as string ?? "GiangVien";
    var muc = ViewData["Muc"] as string ?? "";
    var nd = await Users.GetUserAsync(User);
    var laAdmin = User.IsInRole(VaiTro.Admin);
    var menu = khu == "Admin"
        ? new (string Nhom, string Ma, string Ten, string? Link, string Icon)[]
        {
            ("", "TongQuan", "Tổng quan", "/Admin", "M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z"),
            ("Đào tạo", "KhoaHoc", "Khoá học", "/Admin/KhoaHoc", "M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2zM22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z"),
            ("Đào tạo", "GiaoVien", "Giảng viên", "/Admin/GiaoVien", "M22 10L12 5 2 10l10 5 10-5zM6 12v5c3 2 9 2 12 0v-5"),
            ("Đào tạo", "BaiTap", "Bài tập & bài nộp", "/Admin/BaiTap", "M9 3h6v4H9zM5 5h14v16H5zM9 12h6M9 16h4"),
            ("Đào tạo", "LichDay", "Lịch dạy", "/Admin/LichDay", "M3 5h18v16H3zM7 3v4M17 3v4M3 10h18"),
            ("Học viên", "HocVien", "Học viên & tiến độ", "/Admin/HocVien", "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8"),
            ("Học viên", "GhiDanh", "Ghi danh & hạn học", "/Admin/GhiDanh", "M9 11l3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"),
            ("Học viên", "BaoCao", "Báo cáo hoạt động", "/Admin/BaoCao", "M3 3v18h18M7 16v-5M12 16V7M17 16V4"),
            ("Kinh doanh", "DoanhThu", "Doanh thu & đơn hàng", "/Admin/DoanhThu", "M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"),
            ("Kinh doanh", "GoiHoc", "Gói học & giá", "/Admin/GoiHoc", "M20 12v9H4v-9M2 7h20v5H2zM12 21V7"),
            ("Hệ thống", "NguoiDung", "Tài khoản & phân quyền", "/Admin/NguoiDung", "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8M22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"),
            ("Hệ thống", "TroLy", "Trợ lý AI & tài liệu", "/Admin/TroLy", "M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"),
        }
        : new (string Nhom, string Ma, string Ten, string? Link, string Icon)[]
        {
            ("", "TongQuan", "Bàn làm việc", "/GiangVien", "M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z"),
            ("Soạn cho học viên", "NoiDung", "Khoá học của tôi", "/GiangVien/NoiDung", "M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"),
            ("Soạn cho học viên", "CauHoi", "Bài tập & nộp bài", "/GiangVien/CauHoi", "M9 11l3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"),
            ("Soạn cho học viên", "DeThi", "Đề thi thử", "/GiangVien/DeThi", "M12 21a8 8 0 1 0 0-16 8 8 0 0 0 0 16zM12 9v4l2 2M9 2h6"),
            ("Soạn cho học viên", "LichDay", "Lịch dạy online", "/GiangVien/LichDay", "M2 6h14v12H2zM16 10l6-3v10l-6-3z"),
            ("Theo dõi", "HocVien", "Lớp học", "/GiangVien/HocVien", "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8"),
        };
    string? nhomTruoc = null;
}
@section Head {
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
@* Hiện ngay bằng font hệ thống; không chờ mạng Google Fonts khi chuyển menu. *@
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600&display=swap" media="print" onload="this.media='all'">
<link rel="stylesheet" href="~/css/quan-ly.css" asp-append-version="true">
@if (khu == "Admin") { <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true"> }
@await RenderSectionAsync("Head", required: false)
}
<div class="ql ql--@(khu == "Admin" ? "admin" : "gv")">
<header class="ql-global-head">
<a href="@(khu == "Admin" ? "/Admin" : "/GiangVien")" class="ql-global-brand" aria-label="Sử Địa"><b>Sử<span>·</span>Địa</b></a>
<div class="ql-global-search-wrap" data-global-search><label class="ql-global-search"><svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg><input type="search" placeholder="Tìm trang, chức năng…" aria-label="Tìm trang và chức năng"></label><div class="ql-ket-qua-tim" role="listbox" hidden></div></div>
<div class="ql-global-tools">
<button class="ql-thong-bao-nut" type="button" aria-label="Thông báo" title="Thông báo"><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"></path><path d="M10 21h4"></path></svg></button>
<details class="ql-tai-khoan">
<summary class="ql-nguoi" title="@nd?.Email" aria-label="Mở menu tài khoản">
<span class="ql-avatar" aria-hidden="true">@((nd?.HoTen ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries).LastOrDefault()?[..1].ToUpper())</span>
</summary>
<div class="ql-menu-tai-khoan" role="menu">
<a asp-area="" asp-controller="TaiKhoan" asp-action="HoSo" role="menuitem"><svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg>Thông tin cá nhân</a>
<a asp-area="" asp-controller="TaiKhoan" asp-action="HoSo" asp-fragment="doi-mat-khau" role="menuitem"><svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>Bảo mật</a>
</div>
</details>
<form class="ql-global-dang-xuat" method="post" asp-area="" asp-controller="TaiKhoan" asp-action="DangXuat"><button type="submit" aria-label="Đăng xuất" title="Đăng xuất"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M10 17l5-5-5-5M15 12H3M21 19V5a2 2 0 0 0-2-2h-6"></path></svg></button></form>
</div>
</header>
<aside class="ql-side" aria-label="Menu @(khu == "Admin" ? "quản trị" : "giảng viên")">
<a href="@(khu == "Admin" ? "/Admin" : "/GiangVien")" class="ql-logo"><b>Sử<span>·</span>Địa</b><em>@(khu == "Admin" ? "Quản trị" : "Giảng viên")</em></a>
<button type="button" class="ql-menu-toggle" aria-label="Ẩn menu" title="Ẩn menu"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg></button>
<nav>
@foreach (var m in menu)
{
    if (m.Nhom != nhomTruoc && m.Nhom != "")
    {
<p class="ql-nhom">@m.Nhom</p>
    }
    nhomTruoc = m.Nhom;
    if (m.Link is null)
    {
<span class="ql-link tat" aria-disabled="true"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="@m.Icon"></path></svg>@m.Ten</span>
    }
    else
    {
<a href="@m.Link" class="ql-link @(m.Ma == muc ? "dang-mo" : null)" aria-current="@(m.Ma == muc ? "page" : null)"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="@m.Icon"></path></svg>@m.Ten</a>
    }
}
</nav>
@if (laAdmin)
{
<a href="@(khu == "Admin" ? "/GiangVien" : "/Admin")" class="ql-chuyen">@(khu == "Admin" ? "Sang trang giảng viên" : "Sang trang quản trị") →</a>
}
</aside>
<script>(() => { const a = document.querySelector('.ql-link.dang-mo'); const n = a?.parentElement;
  if (n && n.scrollWidth > n.clientWidth) n.scrollLeft += a.getBoundingClientRect().left - n.getBoundingClientRect().left - (n.clientWidth - a.offsetWidth) / 2;
  const side = document.querySelector('.ql-side'), button = document.querySelector('.ql-menu-toggle'), key = 'sudia.ql.menu';
  const desk = () => matchMedia('(min-width:901px)').matches;
  let state = JSON.parse(localStorage.getItem(key) || '{"hidden":false}'); state.hidden ??= !!state.compact;
  const apply = () => { side.classList.toggle('menu-an', desk() && !!state.hidden); button.setAttribute('aria-label', state.hidden ? 'Mở menu' : 'Ẩn menu'); button.title = button.getAttribute('aria-label'); };
  button.addEventListener('click', () => { state.hidden = !state.hidden; localStorage.setItem(key, JSON.stringify(state)); apply(); });
  addEventListener('resize', apply); apply();
  const host = document.querySelector('[data-global-search]'); if (host) { const input = host.querySelector('input'), box = host.querySelector('[role=listbox]'), norm = (s) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim(); const dongNghia = { 'khoa':'khoa hoc bai hoc noi dung hoc tap', 'bai tap':'cau hoi de thi kiem tra nop bai', 'lich':'lich day lich hoc thoi khoa bieu', 'hoc vien':'lop hoc ghi danh tien do', 'diem':'ket qua danh gia tien do', 'doanh thu':'don hang thanh toan kinh doanh', 'tai khoan':'ho so ca nhan bao mat phan quyen', 'tro ly':'ai tai lieu ho tro', 'goi':'gia nang cap mua thanh toan' }; const muc = () => { const seen = new Set(); return [...document.querySelectorAll('a[href]')].map((a) => { const ten = a.textContent.trim().replace(/\s+/g, ' '), n = norm(ten); return { ten, href: a.href, tim: n + ' ' + Object.entries(dongNghia).filter(([d]) => n.includes(d)).map(([, tu]) => tu).join(' ') }; }).filter((x) => x.ten && !seen.has(x.ten + x.href) && seen.add(x.ten + x.href)); }; const tim = () => { const q = norm(input.value); return q ? muc().map((x) => ({ ...x, diem: norm(x.ten).includes(q) ? 2 : x.tim.includes(q) ? 1 : 0 })).filter((x) => x.diem).sort((a,b) => b.diem - a.diem).slice(0, 8) : []; }; const hien = () => { const kq = tim(); box.replaceChildren(...kq.map((x) => { const a = document.createElement('a'); a.href = x.href; a.textContent = x.ten; a.setAttribute('role', 'option'); return a; })); box.hidden = !kq.length; }; input.addEventListener('input', hien); input.addEventListener('keydown', (e) => { if (e.key === 'Enter') { const hit = tim()[0]; if (hit) { e.preventDefault(); location.href = hit.href; } } if (e.key === 'Escape') box.hidden = true; }); document.addEventListener('click', (e) => { if (!host.contains(e.target)) box.hidden = true; }); }
})();</script>

<div class="ql-than">
<script>(() => { const h=document.querySelector('[data-global-search]'),i=h?.querySelector('input'),b=h?.querySelector('[role=listbox]'); if(!i)return; const n=s=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase(), f=()=>[...document.querySelectorAll('a[href]')].map(a=>({t:a.textContent.trim(),u:a.href})).filter(x=>x.t).map(x=>({...x,s:n(x.t).split(/\s+/).filter(w=>w).reduce((z,w)=>z+(n(i.value).split(/\s+/).some(q=>w.includes(q)||q.includes(w))?1:0),0})).sort((a,c)=>c.s-a.s).slice(0,8); i.addEventListener('input',()=>{const r=f();b.replaceChildren(...r.map(x=>Object.assign(document.createElement('a'),{href:x.u,textContent:x.t})));b.hidden=!r.length});})();</script>
<header class="ql-top">
<div class="ql-top-trai">
@if (ViewData["Crumb"] is string crumb)
{
<p class="ql-crumb">@Html.Raw(crumb)</p>
}
<h1>@ViewData["TieuDe"]</h1>
</div>
<div class="ql-top-phai">
@await RenderSectionAsync("Actions", required: false)
</div>
</header>
@if (TempData["ThongBao"] is string tb)
{
<p class="ql-thong-bao" role="status">@tb</p>
}
@if (TempData["Loi"] is string loi)
{
<p class="ql-thong-bao loi" role="alert">@loi</p>
}
<main class="ql-main">
@RenderBody()
</main>
</div>
</div>
@section Scripts {
<script>
// Nút xoá: hỏi lại trước khi gửi
document.querySelectorAll('form[data-hoi]').forEach((f) => f.addEventListener('submit', (e) => { if (!confirm(f.dataset.hoi)) e.preventDefault(); }));
// Menu ⋮: bấm ra ngoài hoặc Esc thì đóng
document.addEventListener('click', (e) => document.querySelectorAll('details.ql-ba-cham[open], details.ql-tai-khoan[open]').forEach((d) => { if (!d.contains(e.target)) d.open = false; }));
document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const d = document.querySelector('details.ql-tai-khoan[open], details.ql-ba-cham[open]');
    if (d) { d.open = false; d.querySelector('summary').focus(); }
});
</script>
@await RenderSectionAsync("Scripts", required: false)
}
