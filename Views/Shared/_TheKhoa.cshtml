@model TheKhoaModel
@{
    // Ô khoá dùng chung cho "Khoá của tôi" (Luyen = null) và "Luyện đề" (có Luyen)
    var k = Model.Khoa;
    var l = Model.Luyen;
    var cheDoLuyen = l is not null;
    var dangHoc = k.DaMo && k.BaiDaHoc > 0;
    var tiep = k.BaiHocTiep;

    // "Lịch sử 12" -> "Lịch sử" + "12" (số tô màu riêng theo môn)
    var cach = k.Ten.LastIndexOf(' ');
    var tenChu = cach > 0 ? k.Ten[..cach] : k.Ten;
    var tenSo = cach > 0 ? k.Ten[(cach + 1)..] : "";
    var mau = k.Id.StartsWith("dia") ? "ck--xanh" : "ck--vang";
    var trangDich = cheDoLuyen ? "LuyenDe" : "KhoaHoc";

    string nhan = !k.DaMo ? "Học thử"
        : cheDoLuyen ? (l!.DaLuyen > 0 ? "Đang luyện" : "Chưa luyện")
        : (dangHoc ? "Đang học" : "Đã mở");
}
<article class="ck @mau">
<img class="ck-bg" src="@k.Anh" alt="" loading="lazy" width="960" height="540">
<span class="ck-chip@(k.DaMo ? "" : " thu")">
@if (!k.DaMo)
{
<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M22 9L12 4 2 9l10 5 10-5z"></path><path d="M6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"></path></svg>
}
else if (cheDoLuyen)
{
<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
}
else
{
<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5L12 4l9 5.5"></path><path d="M5 10v8M9.5 10v8M14.5 10v8M19 10v8"></path><path d="M3 20h18"></path></svg>
}
@nhan<span class="ck-dot" aria-hidden="true"></span>
</span>

<div class="ck-body">
<h2 class="ck-title"><a asp-controller="Home" asp-action="@trangDich" asp-route-id="@k.Id">@tenChu @if (tenSo.Length > 0) {<span class="ck-so">@tenSo</span>}</a></h2>
<p class="ck-desc">@k.MoTa</p>

@if (k.DaMo && cheDoLuyen)
{
<div class="ck-glass">
<div class="ck-prog-top so">
<span class="ck-prog-l"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path></svg><strong>@l!.DaLuyen/@l.TongBai</strong> bài đã luyện</span>
<span class="ck-pct">@(l.DiemTrungBinh is null ? "—" : "TB " + DinhDang.Diem(l.DiemTrungBinh))</span>
</div>
<div class="ck-bar" role="progressbar" aria-label="Tiến độ luyện đề @k.Ten" aria-valuenow="@l.TienDoPhanTram" aria-valuemin="0" aria-valuemax="100"><span style="width: @(l.TienDoPhanTram)%"></span></div>
</div>
}
else if (k.DaMo)
{
<div class="ck-glass">
<div class="ck-prog-top so">
<span class="ck-prog-l"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2z"></path><path d="M22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z"></path></svg><strong>@k.BaiDaHoc/@k.TongBai</strong> bài</span>
<span class="ck-pct">@(k.TienDoPhanTram)%</span>
</div>
<div class="ck-bar" role="progressbar" aria-label="Tiến độ @k.Ten" aria-valuenow="@k.TienDoPhanTram" aria-valuemin="0" aria-valuemax="100"><span style="width: @(k.TienDoPhanTram)%"></span></div>
</div>
}
else
{
<div class="ck-glass ck-facts">
<div class="ck-fact">
<span class="ck-fact-ico" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path><path d="M14 3v5h5M9 13h6M9 17h6"></path></svg></span>
<span><strong class="so">@k.TongBai bài</strong><span class="ck-fact-sub">Cả khoá</span></span>
</div>
<span class="ck-sep" aria-hidden="true"></span>
<div class="ck-fact">
<span class="ck-fact-ico vang" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2z"></path><path d="M22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z"></path></svg></span>
<span><strong>Miễn phí</strong><span class="ck-fact-sub">@(cheDoLuyen ? "Luyện bài 1" : "Mở bài 1")</span></span>
</div>
</div>
}

<div class="ck-actions">
@if (cheDoLuyen)
{
<a asp-controller="Home" asp-action="LuyenDe" asp-route-id="@k.Id" class="ck-main@(k.DaMo ? "" : " thu")">
<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4.5v15l13-7.5z"></path></svg>
@(k.DaMo ? "Vào luyện đề" : "Luyện thử miễn phí")
<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"></path></svg></a>
}
else if (tiep is not null)
{
<a asp-controller="Home" asp-action="BaiHoc" asp-route-id="@tiep.Id" class="ck-main@(k.DaMo ? "" : " thu")">
<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4.5v15l13-7.5z"></path></svg>
@(k.DaMo ? (dangHoc ? "Tiếp tục học" : "Bắt đầu học") : "Bắt đầu học thử")
<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"></path></svg></a>
}
<button type="button" class="ck-save" data-luu="@k.Id" aria-pressed="false" aria-label="Lưu khoá @k.Ten" title="Lưu khoá">
<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12v18l-6-4-6 4z"></path></svg>
</button>
</div>
</div>
</article>
