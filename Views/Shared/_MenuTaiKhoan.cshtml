@model MenuTaiKhoan
@{
    // Mục đang mở: nền sáng + aria-current; mục khác: chữ nhạt
    string Kieu(string muc) => muc == Model.MucDangMo
        ? "display: flex; align-items: center; gap: 12px; min-height: 42px; padding: 0 12px; border-radius: 8px; background: #17304A; color: #FFFFFF; text-decoration: none; font-size: 15px; font-weight: 600"
        : "display: flex; align-items: center; gap: 12px; min-height: 42px; padding: 0 12px; border-radius: 8px; color: #B6C4D2; text-decoration: none; font-size: 15px; font-weight: 500";
    string? Hien(string muc) => muc == Model.MucDangMo ? "page" : null;
    string MauIcon(string muc) => muc == Model.MucDangMo ? "#5EEAD4" : "currentColor";
}
<nav aria-label="Menu tài khoản" style="flex: 1 1 240px; max-width: 100%; background: #0B1A2B; color: #C7D3DF; padding: 22px 16px; display: flex; flex-direction: column; gap: 4px; box-sizing: border-box">
<a asp-controller="Home" asp-action="Index" style="display: flex; align-items: baseline; gap: 10px; padding: 2px 12px 26px; text-decoration: none; color: #FFFFFF">
<span style="font-size: 20px; font-weight: 700; letter-spacing: -0.02em">Sử<span style="color: #5EEAD4">·</span>Địa</span>
<span style="font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #8FA3B8">Học sinh</span>
</a>
<a asp-controller="Home" asp-action="TongQuan" aria-current="@Hien("TongQuan")" style="@Kieu("TongQuan")">
<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="@MauIcon("TongQuan")" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect><rect x="3" y="14" width="7" height="7" rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"></rect></svg>Tổng quan</a>
<a asp-controller="Home" asp-action="KhoaHoc" asp-route-id="" aria-current="@Hien("KhoaHoc")" style="@Kieu("KhoaHoc")">
<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="@MauIcon("KhoaHoc")" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2z"></path><path d="M22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z"></path></svg>Khoá của tôi</a>
<a asp-controller="Home" asp-action="LuyenDe" asp-route-id="" aria-current="@Hien("LuyenDe")" style="@Kieu("LuyenDe")">
<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>Luyện đề</a>
<a asp-controller="Home" asp-action="BaiHoc" style="@Kieu("HoiAi")">
<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>Hỏi AI</a>
<a asp-controller="Home" asp-action="Index" asp-fragment="goi" style="@Kieu("MuaGoi")">
<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12v9H4v-9"></path><path d="M2 7h20v5H2z"></path><path d="M12 21V7"></path></svg>Mua thêm gói</a>
<div style="margin-top: 24px; padding: 16px; border-radius: 10px; background: #11263B; border: 1px solid #1F3A55">
<p style="margin: 0 0 6px; font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #8FA3B8">Lượt hỏi AI hôm nay</p>
<p style="margin: 0 0 10px; font-size: 22px; font-weight: 700; color: #FFFFFF; font-variant-numeric: tabular-nums">@Model.LuotHoiDaDung<span style="font-size: 14px; font-weight: 500; color: #8FA3B8"> / @Model.LuotHoiToiDa</span></p>
<div style="height: 4px; border-radius: 99px; background: #23405C"><div style="width: @(Model.LuotHoiPhanTram)%; height: 4px; border-radius: 99px; background: #5EEAD4"></div></div>
</div>
</nav>
