@model MenuTaiKhoan
@{
    string Kieu(string muc) => "hv-link" + (muc == Model.MucDangMo ? " dang-mo" : "");
    string? Hien(string muc) => muc == Model.MucDangMo ? "page" : null;
}
<aside class="hv-side" aria-label="Khu học viên">
<a asp-controller="Home" asp-action="Index" class="hv-logo"><b>Sử<span>·</span>Địa</b><em>Học viên</em></a>
<nav class="hv-nav" aria-label="Menu tài khoản">
<p class="hv-nhom">Học tập</p>
<a asp-controller="Home" asp-action="TongQuan" aria-current="@Hien("TongQuan")" class="@Kieu("TongQuan")">
<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect><rect x="3" y="14" width="7" height="7" rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"></rect></svg>Tổng quan</a>
<a asp-controller="Home" asp-action="KhoaHoc" asp-route-id="" aria-current="@Hien("KhoaHoc")" class="@Kieu("KhoaHoc")">
<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2z"></path><path d="M22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z"></path></svg>Khoá của tôi</a>
<a asp-controller="Home" asp-action="LuyenDe" asp-route-id="" aria-current="@Hien("LuyenDe")" class="@Kieu("LuyenDe")">
<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>Luyện đề</a>
<a asp-controller="Home" asp-action="HoiAi" aria-current="@Hien("HoiAi")" class="@Kieu("HoiAi")">
<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>Hỏi AI</a>
<a asp-controller="Home" asp-action="Index" asp-fragment="goi" class="@Kieu("MuaGoi")">
<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12v9H4v-9"></path><path d="M2 7h20v5H2z"></path><path d="M12 21V7"></path></svg>Mua thêm gói</a>
</nav>
<div class="hv-luot">
<p class="hv-luot-nhan">Lượt hỏi AI hôm nay</p>
<p class="hv-luot-so">@Model.LuotHoiDaDung<span> / @Model.LuotHoiToiDa</span></p>
<div class="hv-thanh" role="progressbar" aria-label="Lượt hỏi AI đã dùng" aria-valuemin="0" aria-valuemax="@Model.LuotHoiToiDa" aria-valuenow="@Model.LuotHoiDaDung"><span style="width: @(Model.LuotHoiPhanTram)%"></span></div>
</div>
<form method="post" asp-area="" asp-controller="TaiKhoan" asp-action="DangXuat" class="hv-dang-xuat">
<button type="submit">Đăng xuất</button>
</form>
</aside>
