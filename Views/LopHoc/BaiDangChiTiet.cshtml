@model BaiDangViewModel
@{ ViewData["Title"] = Model.TieuDe + " · Diễn đàn"; }
@section Head {
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600&display=swap">
<link rel="stylesheet" href="~/css/hoc-vien.css" asp-append-version="true">
}
<div class="hv-trang">
<partial name="_MenuTaiKhoan" model="Model.Menu" />
<main class="hv-main">
<p class="dd-crumb"><a asp-action="Index">Lớp học</a> › <a asp-action="DienDan" asp-route-id="@Model.LopId">@Model.LopTen</a></p>
<h1>@Model.TieuDe</h1>
<partial name="_ThongBao" />

<section class="hv-khoi dd-bai">
<p class="dd-tac-gia"><b>@Model.TacGia</b>@(Model.TacGiaLaGiangVien ? " (giảng viên)" : "") · @DinhDang.GioNgay(Model.NgayTao.ToLocalTime())
@if (Model.Ghim) { <em class="dd-chip ghim">Ghim</em> }
@if (Model.DaDong) { <em class="dd-chip dong">Đã đóng</em> }</p>
<div class="dd-noi-dung">@Model.NoiDung</div>
@if (Model.QuanLy || Model.LaTacGia)
{
<div class="dd-hanh-dong">
@if (Model.QuanLy)
{
<form method="post" asp-action="Ghim" asp-route-id="@Model.Id"><button class="hv-nut phu nho">@(Model.Ghim ? "Bỏ ghim" : "Ghim lên đầu")</button></form>
<form method="post" asp-action="Dong" asp-route-id="@Model.Id"><button class="hv-nut phu nho">@(Model.DaDong ? "Mở lại bài" : "Đóng bài")</button></form>
}
<form method="post" asp-action="XoaBai" asp-route-id="@Model.Id" onsubmit="return confirm('Xoá bài này cùng mọi trả lời?')"><button class="hv-nut phu nho xoa">Xoá bài</button></form>
</div>
}
</section>

<section class="hv-khoi">
<div class="hv-khoi-dau"><h2>@Model.TraLoi.Count trả lời</h2></div>
@if (Model.TraLoi.Count == 0) { <p class="hv-trong">Chưa có trả lời.</p> }
<ul class="dd-tl">
@foreach (var t in Model.TraLoi)
{
<li class="@(t.LaDapAn ? "dap-an" : "")">
<p class="dd-tac-gia"><b>@t.TacGia</b>@(t.TacGiaLaGiangVien ? " (giảng viên)" : "") · @DinhDang.GioNgay(t.NgayTao.ToLocalTime())
@if (t.LaDapAn) { <em class="dd-chip dap-an">Đáp án</em> }</p>
<div class="dd-noi-dung">@t.NoiDung</div>
<div class="dd-hanh-dong">
@if (Model.QuanLy || Model.LaTacGia)
{
<form method="post" asp-action="DapAn" asp-route-id="@Model.Id" asp-route-traLoiId="@t.Id"><button class="hv-nut phu nho">@(t.LaDapAn ? "Bỏ đánh dấu đáp án" : "Đánh dấu là đáp án")</button></form>
}
@if (t.CoTheXoa)
{
<form method="post" asp-action="XoaTraLoi" asp-route-id="@Model.Id" asp-route-traLoiId="@t.Id" onsubmit="return confirm('Xoá trả lời này?')"><button class="hv-nut phu nho xoa">Xoá</button></form>
}
</div>
</li>
}
</ul>
</section>

@if (Model.DaDong)
{
<p class="hv-ghi-chu">Bài đã đóng, không trả lời thêm được.</p>
}
else
{
<section class="hv-khoi">
<div class="hv-khoi-dau"><h2>Trả lời</h2></div>
<form method="post" asp-action="TraLoi" asp-route-id="@Model.Id" class="dd-form">
<label for="noiDung" class="hv-an">Nội dung trả lời</label>
<textarea id="noiDung" name="noiDung" rows="4" maxlength="@GioiHanDienDan.NoiDung" placeholder="Viết trả lời của bạn…" required>@Model.TraLoiNhap</textarea>
<div class="dd-form-chan"><button class="hv-nut">Gửi trả lời</button></div>
</form>
</section>
}
</main>
</div>
