@model DienDanViewModel
@{ ViewData["Title"] = Model.Lop.Ten + " · Diễn đàn"; }
@section Head {
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600&display=swap">
<link rel="stylesheet" href="~/css/hoc-vien.css" asp-append-version="true">
}
<div class="hv-trang">
<partial name="_MenuTaiKhoan" model="Model.Menu" />
<main class="hv-main">
<p class="dd-crumb"><a asp-action="Index">Lớp học</a> › @Model.Lop.Ten</p>
<h1>@Model.Lop.Ten</h1>
<p class="hv-mo-ta">@Model.Lop.Khoa · @Model.Lop.SoHocVien học viên@(string.IsNullOrWhiteSpace(Model.MoTa) ? "" : " · " + Model.MoTa)</p>
<partial name="_ThongBao" />
@if (Model.QuanLy)
{
<p class="hv-ghi-chu">Mã lớp: <b class="dd-ma">@Model.Lop.MaThamGia</b>@(Model.Lop.DangMo ? "" : " (đang ngừng nhận học viên)") · <a href="/GiangVien/Lop/ChiTiet/@Model.Lop.Id">Quản lý lớp</a></p>
}

<section class="hv-khoi">
<div class="hv-khoi-dau"><h2>Đặt câu hỏi hoặc mở chủ đề</h2></div>
<form method="post" asp-action="DangBai" asp-route-id="@Model.Lop.Id" class="dd-form">
<label for="tieuDe" class="hv-an">Tiêu đề</label>
<input id="tieuDe" name="tieuDe" value="@Model.TieuDeNhap" maxlength="@GioiHanDienDan.TieuDe" placeholder="Tiêu đề ngắn gọn, ví dụ: Em chưa hiểu vì sao Pháp thất bại ở Điện Biên Phủ" required>
<label for="noiDung" class="hv-an">Nội dung</label>
<textarea id="noiDung" name="noiDung" rows="4" maxlength="@GioiHanDienDan.NoiDung" placeholder="Mô tả chi tiết điều bạn muốn hỏi hoặc chia sẻ…" required>@Model.NoiDungNhap</textarea>
<div class="dd-form-chan"><button class="hv-nut">Đăng bài</button></div>
</form>
</section>

<section class="hv-khoi">
<div class="hv-khoi-dau"><h2>Thảo luận</h2><span class="hv-ghi-chu">@Model.BaiDang.Count bài</span></div>
@if (Model.BaiDang.Count == 0)
{
<p class="hv-trong">Chưa có bài nào. Hãy là người đặt câu hỏi đầu tiên.</p>
}
else
{
<ul class="dd-ds">
@foreach (var b in Model.BaiDang)
{
<li class="@(b.Ghim ? "ghim" : "")">
<a asp-action="BaiDangChiTiet" asp-route-id="@b.Id" class="dd-tieu-de">@b.TieuDe</a>
<span class="dd-nhan">
@if (b.Ghim) { <em class="dd-chip ghim">Ghim</em> }
@if (b.CoDapAn) { <em class="dd-chip dap-an">Đã có đáp án</em> }
@if (b.DaDong) { <em class="dd-chip dong">Đã đóng</em> }
</span>
<small>@b.TacGia@(b.TacGiaLaGiangVien ? " (giảng viên)" : "") · @DinhDang.GioNgay(b.NgayTao.ToLocalTime()) · @b.SoTraLoi trả lời@(b.SoTraLoi > 0 ? " · mới nhất " + DinhDang.GioNgay(b.HoatDongCuoi.ToLocalTime()) : "")</small>
</li>
}
</ul>
}
</section>

@if (!Model.QuanLy)
{
<form method="post" asp-action="Roi" asp-route-id="@Model.Lop.Id" onsubmit="return confirm('Rời lớp này?')"><button class="hv-nut phu">Rời lớp</button></form>
}
</main>
</div>
