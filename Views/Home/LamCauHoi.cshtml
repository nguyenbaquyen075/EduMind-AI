@model LamCauHoiViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Làm câu hỏi";
}
@section Head {
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap">
<link rel="stylesheet" href="~/css/lam-cau-hoi.css" asp-append-version="true">
}

<div style="min-height: 100vh; background: #F4F6F8; color: #0F1B2D; font-family: 'Be Vietnam Pro', system-ui, sans-serif; font-size: 16px; line-height: 1.6">

<header style="background: #0B1A2B; color: #E6EDF3">
<div style="padding: 12px 24px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px">
<div style="display: flex; flex-wrap: wrap; align-items: center; gap: 14px">
<a asp-controller="Home" asp-action="LuyenDe" asp-route-id="@Model.KhoaId" style="display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 12px; border-radius: 10px; border: 1px solid #2E4A66; color: #E6EDF3; text-decoration: none; font-weight: 600">
<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"></path></svg>Luyện đề</a>
<span style="font-weight: 700">@Model.TenBai</span>
</div>
<span style="display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 10px; background: #11263B; border: 1px solid #23405C; font-family: 'JetBrains Mono', monospace; font-weight: 600; color: #5EEAD4">
<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="8"></circle><path d="M12 9v4l2 2"></path><path d="M9 2h6"></path></svg>@Model.ThoiGianConLai</span>
</div>
</header>

<div style="max-width: 1160px; margin: 0 auto; padding: 28px 24px 48px; display: flex; flex-wrap: wrap; align-items: flex-start; gap: 24px">

<div style="flex: 999 1 560px; min-width: 0">
<div style="display: flex; align-items: center; gap: 14px; margin-bottom: 18px">
<span style="font-family: 'JetBrains Mono', monospace; font-size: 13px; font-weight: 600; color: #52606D">CÂU @Model.CauSo/@Model.TongCau</span>
<div style="flex: 1 1 auto; height: 8px; border-radius: 99px; background: #E1E6EB"><div style="width: @(Model.TienDoPhanTram)%; height: 8px; border-radius: 99px; background: #0E7C66"></div></div>
</div>

<main style="background: #FFFFFF; border: 1px solid #E1E6EB; border-radius: 16px; padding: 32px 36px">
<span style="display: inline-block; margin-bottom: 14px; font-family: 'JetBrains Mono', monospace; font-size: 12px; padding: 3px 10px; border-radius: 6px; background: #E0F4EF; color: #0A5C4C">@Model.MucDo</span>
<h1 style="margin: 0 0 26px; font-size: 23px; line-height: 1.4; font-weight: 700">@Model.NoiDung</h1>

<form asp-controller="Home" asp-action="LamCauHoi" asp-route-id="@Model.Id" method="post">
<div role="group" aria-label="Các phương án" style="display: flex; flex-direction: column; gap: 12px">
@foreach (var pa in Model.PhuongAn)
{
    // Màu từng phương án: chưa trả lời -> trung tính; đã trả lời -> đáp án đúng xanh, lựa chọn sai đỏ
    var nen = "#FFFFFF"; var vien = "1px solid #D5DCE2"; var nenKy = "#F4F6F8"; var chuKy = "#0F1B2D";
    if (Model.DaTraLoi && pa.Ky == Model.DapAnDung) { nen = "#E0F4EF"; vien = "2px solid #0E7C66"; nenKy = "#0E7C66"; chuKy = "#FFFFFF"; }
    else if (Model.DaTraLoi && pa.Ky == Model.DapAnDaChon) { nen = "#FDECE4"; vien = "2px solid #C2410C"; nenKy = "#C2410C"; chuKy = "#FFFFFF"; }
<button type="submit" name="dapAn" value="@pa.Ky" aria-pressed="@(pa.Ky == Model.DapAnDaChon ? "true" : "false")" disabled="@Model.DaTraLoi" style="display: flex; align-items: center; gap: 14px; width: 100%; min-height: 56px; padding: 10px 16px; border-radius: 12px; font: inherit; font-size: 17px; color: #0F1B2D; cursor: @(Model.DaTraLoi ? "default" : "pointer"); background: @nen; border: @vien;">
<span style="flex: 0 0 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-family: 'JetBrains Mono', monospace; font-weight: 600; background: @nenKy; color: @chuKy;">@pa.Ky</span>
<span style="flex: 1 1 auto; text-align: left">@pa.NoiDung</span>
</button>
}
</div>
</form>

@if (Model.DaTraLoi)
{
<div style="margin-top: 22px; padding: 18px 20px; border-radius: 12px; background: #F4F6F8">
    @if (Model.TraLoiDung)
    {
<p style="margin: 0 0 6px; font-weight: 700; color: #0A5C4C">Chính xác!</p>
    }
    else
    {
<p style="margin: 0 0 6px; font-weight: 700; color: #9A3412">Chưa đúng. Đáp án đúng là @Model.DapAnDung.</p>
    }
<p style="margin: 0 0 12px; color: #334155">@Model.GiaiThich</p>
<div style="display: flex; flex-wrap: wrap; gap: 8px">
<a asp-controller="Home" asp-action="BaiHoc" style="display: inline-flex; align-items: center; min-height: 38px; padding: 0 12px; border-radius: 8px; background: #E0F4EF; color: #0A5C4C; text-decoration: none; font-weight: 600; font-size: 14px">Xem lại @Model.NguonMuc</a>
<a asp-controller="Home" asp-action="BaiHoc" style="display: inline-flex; align-items: center; min-height: 38px; padding: 0 12px; border-radius: 8px; border: 1px solid #C5CED6; color: #0F1B2D; text-decoration: none; font-weight: 600; font-size: 14px">Hỏi AI về câu này</a>
</div>
</div>
}
</main>

<div style="display: flex; justify-content: space-between; gap: 12px; margin-top: 20px">
<a asp-controller="Home" asp-action="LamCauHoi" asp-route-id="@Model.Id" style="display: inline-flex; align-items: center; min-height: 50px; padding: 0 22px; border-radius: 12px; border: 1px solid #C5CED6; background: #FFFFFF; color: #0F1B2D; text-decoration: none; font-weight: 600">Câu trước</a>
<a asp-controller="Home" asp-action="LamCauHoi" asp-route-id="@Model.Id" style="display: inline-flex; align-items: center; min-height: 50px; padding: 0 28px; border-radius: 12px; background: #0E7C66; color: #FFFFFF; text-decoration: none; font-weight: 700">Câu tiếp theo</a>
</div>
</div>

<aside aria-label="Bảng câu hỏi" style="flex: 1 1 260px; max-width: 100%; background: #FFFFFF; border: 1px solid #E1E6EB; border-radius: 16px; padding: 22px">
<p style="margin: 0 0 14px; font-weight: 700">Bảng câu hỏi</p>
<div style="display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; margin-bottom: 18px">
@foreach (var o in Model.BangCau)
{
    var vienDangLam = o.DangLam ? "2px solid #0F1B2D" : "none";
    var kieu = o.TrangThai switch
    {
        TrangThaiCau.Dung => $"background: #0E7C66; color: #FFFFFF; border: {vienDangLam};",
        TrangThaiCau.Sai => $"background: #C2410C; color: #FFFFFF; border: {vienDangLam};",
        _ when o.DangLam => "background: #FFFFFF; color: #0F1B2D; border: 2px solid #0F1B2D;",
        _ => "background: #F4F6F8; color: #52606D; border: none;",
    };
<button type="button" aria-label="Câu @o.So" style="height: 42px; border-radius: 10px; font-family: 'JetBrains Mono', monospace; font-weight: 600; font-size: 14px; cursor: pointer; @kieu">@o.So</button>
}
</div>
<div style="display: flex; flex-direction: column; gap: 6px; font-size: 13px; color: #52606D; margin-bottom: 20px">
<span style="display: flex; align-items: center; gap: 8px"><span style="width: 12px; height: 12px; border-radius: 3px; background: #0E7C66"></span>Đúng</span>
<span style="display: flex; align-items: center; gap: 8px"><span style="width: 12px; height: 12px; border-radius: 3px; background: #C2410C"></span>Sai</span>
<span style="display: flex; align-items: center; gap: 8px"><span style="width: 12px; height: 12px; border-radius: 3px; border: 2px solid #0F1B2D"></span>Đang làm</span>
</div>
<button type="button" style="width: 100%; min-height: 48px; border-radius: 12px; border: none; background: #0B1A2B; color: #FFFFFF; font: inherit; font-weight: 700; cursor: pointer">Nộp bài</button>
</aside>

</div>
</div>
