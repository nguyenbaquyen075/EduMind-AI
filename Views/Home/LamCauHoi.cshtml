@model LamDeViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.TenDe;
    var tong = Model.CauHoi.Count;
}
@section Head {
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="~/css/lam-cau-hoi.css" asp-append-version="true">
}

<div class="ld">

<header class="ld-head">
<a asp-controller="Home" asp-action="LuyenDe" asp-route-id="@Model.KhoaId" class="ld-back">
<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"></path></svg>Luyện đề</a>
<span class="ld-ten">@Model.TenDe</span>
@if (Model.SoPhut is not null && !Model.DaNop && tong > 0)
{
<span class="ld-gio so" id="dongHo" data-giay="@(Model.SoPhut * 60)" role="timer" aria-live="off">
<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="8"></circle><path d="M12 9v4l2 2"></path><path d="M9 2h6"></path></svg><span>@(Model.SoPhut):00</span></span>
}
</header>

@if (tong == 0)
{
<main class="ld-trong">
<p class="ld-trong-tieu">Chưa có câu hỏi cho phần này</p>
<p>Câu hỏi sẽ có khi nạp ngân hàng câu hỏi của khoá. Bạn có thể luyện Bài 6, Bài 7 hoặc đề thi thử.</p>
<a asp-controller="Home" asp-action="LuyenDe" asp-route-id="@Model.KhoaId" class="ld-nut chinh">Về trang luyện đề</a>
</main>
}
else
{
<div class="ld-body">

@* ---------------------------------------------------------------- Kết quả sau khi nộp *@
<main class="ld-main">
@if (Model.DaNop)
{
    var tot = Model.SoDung >= tong * 0.8;
<section class="ld-ketqua @(tot ? "tot" : "vua")" aria-labelledby="kq">
<div>
<p class="ld-kq-nhan">Kết quả</p>
<h1 id="kq" class="ld-kq-diem so">@DinhDang.Diem(Model.Diem) <small>điểm</small></h1>
<p class="ld-kq-chi-tiet so">Đúng @Model.SoDung/@tong câu@(Model.SoBoTrong > 0 ? $" · bỏ trống {Model.SoBoTrong} câu" : "")</p>
</div>
<div class="ld-kq-nut">
<a asp-controller="Home" asp-action="LamCauHoi" asp-route-id="@Model.Id" class="ld-nut">Làm lại</a>
<a asp-controller="Home" asp-action="LuyenDe" asp-route-id="@Model.KhoaId" class="ld-nut chinh">Về luyện đề</a>
</div>
</section>
}
else
{
<p class="ld-huong-dan">@tong câu · chọn một đáp án cho mỗi câu. Đáp án và lời giải hiện sau khi nộp bài.</p>
}

<form asp-controller="Home" asp-action="LamCauHoi" asp-route-id="@Model.Id" method="post" id="formDe">
<ol class="ld-ds">
@for (var i = 1; i <= tong; i++)
{
    var c = Model.CauHoi[i - 1];
    var chon = Model.Chon(i);
    var trangThai = !Model.DaNop ? "" : chon is null ? " bo-trong" : Model.Dung(i) ? " dung" : " sai";
<li class="ld-cau@(trangThai)" id="cau-@i">
<fieldset>
<legend><span class="ld-so">Câu @i</span>@c.NoiDung</legend>
<div class="ld-pa">
    @foreach (var pa in c.PhuongAn)
    {
        var la = !Model.DaNop ? "" : pa.Ky == c.DapAnDung ? " la-dung" : pa.Ky == chon ? " la-sai" : "";
<label class="ld-lua-chon@(la)">
<input type="radio" name="cau-@i" value="@pa.Ky" checked="@(pa.Ky == chon)" disabled="@Model.DaNop">
<span class="ld-ky">@pa.Ky</span><span class="ld-nd">@pa.NoiDung</span>
        @if (la == " la-dung")
        {
<span class="ld-dau" aria-label="Đáp án đúng">✓</span>
        }
        else if (la == " la-sai")
        {
<span class="ld-dau" aria-label="Bạn chọn, chưa đúng">✗</span>
        }
</label>
    }
</div>
    @if (Model.DaNop)
    {
<div class="ld-giai">
<p class="ld-giai-dau">@(chon is null ? $"Bạn bỏ trống. Đáp án đúng: {c.DapAnDung}." : Model.Dung(i) ? "Chính xác." : $"Chưa đúng. Đáp án đúng: {c.DapAnDung}.")</p>
<p>@c.GiaiThich</p>
<a asp-controller="Home" asp-action="BaiHoc" asp-route-id="@c.BaiId" asp-fragment="@(c.Muc is null ? null : $"muc-{c.Muc}")" class="ld-nguon">Xem lại: @c.NguonHienThi →</a>
</div>
    }
</fieldset>
</li>
}
</ol>
@if (!Model.DaNop)
{
<div class="ld-nop">
<span id="conTrong" class="so" aria-live="polite">Đã làm 0/@tong câu</span>
<button type="submit" class="ld-nut chinh">Nộp bài</button>
</div>
}
</form>
</main>

@* ---------------------------------------------------------------- Bảng câu *@
<aside class="ld-bang" aria-label="Bảng câu hỏi">
<p class="ld-bang-tieu">Bảng câu</p>
<div class="ld-o-luoi">
@for (var i = 1; i <= tong; i++)
{
    var o = !Model.DaNop ? "" : Model.Chon(i) is null ? " bo-trong" : Model.Dung(i) ? " dung" : " sai";
<a href="#cau-@i" class="ld-o@(o)" data-o="@i">@i</a>
}
</div>
@if (Model.DaNop)
{
<p class="ld-chu-giai"><span class="ld-o mau dung"></span>Đúng <span class="ld-o mau sai"></span>Sai <span class="ld-o mau bo-trong"></span>Bỏ trống</p>
}
else
{
<button type="submit" form="formDe" class="ld-nut chinh ld-nop-ben">Nộp bài</button>
}
</aside>

</div>
}

</div>

@if (!Model.DaNop && tong > 0)
{
@section Scripts {
<script>
// Đang làm: đếm câu đã chọn, tô ô ở bảng câu, hỏi lại nếu còn bỏ trống; đề thi có đồng hồ, hết giờ tự nộp
(() => {
  const form = document.getElementById('formDe');
  const tong = @tong;
  const dem = document.getElementById('conTrong');
  const daLam = () => new Set([...form.querySelectorAll('input[type=radio]:checked')].map((r) => r.name)).size;
  const capNhat = () => {
    dem.textContent = `Đã làm ${daLam()}/${tong} câu`;
    for (let i = 1; i <= tong; i++)
      document.querySelector(`[data-o="${i}"]`).classList.toggle('da-lam', !!form.querySelector(`input[name="cau-${i}"]:checked`));
  };
  form.addEventListener('change', capNhat);
  capNhat();

  let tuNop = false;
  form.addEventListener('submit', (e) => {
    const trong = tong - daLam();
    if (!tuNop && trong > 0 && !confirm(`Còn ${trong} câu chưa làm. Vẫn nộp bài?`)) e.preventDefault();
  });

  const dongHo = document.getElementById('dongHo');
  if (dongHo) {
    let giay = Number(dongHo.dataset.giay);
    const hien = dongHo.querySelector('span');
    const chay = setInterval(() => {
      giay--;
      hien.textContent = `${Math.floor(giay / 60)}:${String(giay % 60).padStart(2, '0')}`;
      dongHo.classList.toggle('sap-het', giay <= 300);
      if (giay <= 0) { clearInterval(chay); tuNop = true; form.requestSubmit(); }
    }, 1000);
  }
})();
</script>
}
}
