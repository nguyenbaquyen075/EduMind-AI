@model TongQuanViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Tổng quan tài khoản";
}
@section Head {
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap">
<link rel="stylesheet" href="~/css/tong-quan.css" asp-append-version="true">
}

<div style="min-height: 100vh; background: #F4F6F8; color: #0F1B2D; font-family: 'Be Vietnam Pro', system-ui, sans-serif; font-size: 16px; line-height: 1.6; display: flex; flex-wrap: wrap">

<partial name="_MenuTaiKhoan" model="Model.Menu" />

<main style="flex: 999 1 640px; min-width: 0; padding: 28px 32px 48px; box-sizing: border-box">
<div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 28px">
<div>
<p style="margin: 0; font-family: 'JetBrains Mono', monospace; font-size: 13px; color: #52606D">@DinhDang.NgayDauTrang(Model.NgayHomNay)</p>
<h1 style="margin: 0; font-size: 30px; font-weight: 800; letter-spacing: -0.5px">Chào @Model.TenHocSinh, học tiếp nhé</h1>
</div>
<div style="display: flex; align-items: center; gap: 12px">
<label style="display: flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 14px; border-radius: 10px; background: #FFFFFF; border: 1px solid #E1E6EB; color: #52606D">
<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
<input type="search" placeholder="Tìm bài học…" aria-label="Tìm bài học" style="border: none; outline: none; font: inherit; width: 180px; background: transparent; color: #0F1B2D">
</label>
<div aria-label="Tài khoản" style="width: 44px; height: 44px; border-radius: 99px; background: #0E7C66; color: #FFFFFF; font-weight: 700; display: flex; align-items: center; justify-content: center">@Model.ChuCaiDaiDien</div>
</div>
</div>

<div style="display: flex; flex-wrap: wrap; gap: 20px; margin-bottom: 20px">
<div style="flex: 2 1 460px; min-width: 0; background-color: #0B1A2B; background-image: linear-gradient(rgba(94,234,212,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(94,234,212,0.06) 1px, transparent 1px); background-size: 32px 32px; color: #E6EDF3; border-radius: 18px; padding: 28px">
<p style="margin: 0 0 6px; font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #5EEAD4">TIẾP TỤC HỌC · @Model.TiepTuc.Mon.ToUpper()</p>
<h2 style="margin: 0 0 4px; font-size: 24px; font-weight: 800; color: #FFFFFF">@Model.TiepTuc.Bai</h2>
<p style="margin: 0 0 20px; color: #A9B8C8">Đang đọc: @Model.TiepTuc.Muc</p>
<div style="display: flex; align-items: center; gap: 12px; margin-bottom: 22px">
<div style="flex: 1 1 auto; height: 8px; border-radius: 99px; background: #23405C"><div style="width: @(Model.TiepTuc.TienDoPhanTram)%; height: 8px; border-radius: 99px; background: #5EEAD4"></div></div>
<span style="font-family: 'JetBrains Mono', monospace; font-size: 13px; color: #C7D3DF">@(Model.TiepTuc.TienDoPhanTram)%</span>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 10px">
<a asp-controller="Home" asp-action="BaiHoc" style="display: inline-flex; align-items: center; min-height: 48px; padding: 0 24px; border-radius: 12px; background: #5EEAD4; color: #0B1A2B; text-decoration: none; font-weight: 700">Học tiếp</a>
<a asp-controller="Home" asp-action="LamCauHoi" style="display: inline-flex; align-items: center; min-height: 48px; padding: 0 20px; border-radius: 12px; border: 1px solid #2E4A66; color: #E6EDF3; text-decoration: none; font-weight: 600">Làm câu hỏi bài này</a>
</div>
</div>

<div style="flex: 1 1 260px; min-width: 0; background: #FFFFFF; border: 1px solid #E1E6EB; border-radius: 18px; padding: 24px; display: flex; flex-direction: column; gap: 14px">
<p style="margin: 0; font-weight: 700">Tuần này</p>
<div style="display: flex; justify-content: space-between; align-items: baseline"><span style="color: #52606D">Bài đã học</span><span style="font-size: 22px; font-weight: 800">@Model.ThongKe.BaiDaHoc</span></div>
<div style="display: flex; justify-content: space-between; align-items: baseline"><span style="color: #52606D">Câu hỏi đã làm</span><span style="font-size: 22px; font-weight: 800">@Model.ThongKe.CauDaLam</span></div>
<div style="display: flex; justify-content: space-between; align-items: baseline"><span style="color: #52606D">Tỉ lệ đúng</span><span style="font-size: 22px; font-weight: 800; color: #0E7C66">@(Model.ThongKe.TiLeDung)%</span></div>
<div style="display: flex; justify-content: space-between; align-items: baseline"><span style="color: #52606D">Chuỗi ngày học</span><span style="font-size: 22px; font-weight: 800">@Model.ThongKe.ChuoiNgay ngày</span></div>
</div>
</div>

<div style="display: flex; flex-wrap: wrap; gap: 20px">
<section style="flex: 1 1 340px; min-width: 0; background: #FFFFFF; border: 1px solid #E1E6EB; border-radius: 18px; padding: 24px">
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px">
<h2 style="margin: 0; font-size: 18px">Khoá của tôi</h2>
<a asp-controller="Home" asp-action="KhoaHoc" style="font-size: 14px; font-weight: 600; text-decoration: none">Xem tất cả</a>
</div>
<div style="display: flex; flex-direction: column; gap: 12px">
@foreach (var k in Model.KhoaCuaToi)
{
    if (k.DaMo)
    {
<a asp-controller="Home" asp-action="KhoaHoc" asp-route-id="@k.Id" style="display: flex; align-items: center; gap: 14px; padding: 14px; border-radius: 12px; border: 1px solid #E1E6EB; text-decoration: none; color: #0F1B2D">
<span style="width: 44px; height: 44px; border-radius: 11px; background: #E0F4EF; color: #0E7C66; font-weight: 800; display: flex; align-items: center; justify-content: center">@k.KyHieu</span>
<span style="flex: 1 1 auto; min-width: 0">
<span style="display: block; font-weight: 700">@k.Ten</span>
<span style="display: block; height: 6px; border-radius: 99px; background: #E6EBEF; margin: 6px 0 4px"><span style="display: block; width: @(k.TienDoPhanTram)%; height: 6px; border-radius: 99px; background: #0E7C66"></span></span>
<span style="display: block; font-size: 13px; color: #52606D">@k.BaiDaHoc/@k.TongBai bài · hạn đến @DinhDang.Ngay(k.HanDen)</span>
</span>
</a>
    }
    else
    {
<div style="display: flex; align-items: center; gap: 14px; padding: 14px; border-radius: 12px; border: 1px dashed #C5CED6; color: #52606D">
<span style="width: 44px; height: 44px; border-radius: 11px; background: #F4F6F8; font-weight: 800; display: flex; align-items: center; justify-content: center">@k.KyHieu</span>
<a asp-controller="Home" asp-action="KhoaHoc" asp-route-id="@k.Id" style="flex: 1 1 auto; text-decoration: none; color: inherit"><span style="display: block; font-weight: 700; color: #0F1B2D">@k.Ten</span><span style="font-size: 13px">Chưa mở khoá · học thử bài 1</span></a>
<a asp-controller="Home" asp-action="Index" asp-fragment="goi" style="font-size: 14px; font-weight: 700; text-decoration: none">Mở khoá</a>
</div>
    }
}
</div>
</section>

<section style="flex: 1 1 340px; min-width: 0; background: #FFFFFF; border: 1px solid #E1E6EB; border-radius: 18px; padding: 24px">
<h2 style="margin: 0 0 16px; font-size: 18px">Kết quả gần đây</h2>
<div style="display: flex; flex-direction: column">
@for (var i = 0; i < Model.KetQuaGanDay.Count; i++)
{
    var kq = Model.KetQuaGanDay[i];
    var vien = i < Model.KetQuaGanDay.Count - 1 ? " border-bottom: 1px solid #EEF1F4;" : "";
    var mau = kq.Tot ? "#0E7C66" : "#A15C07";
<div style="display: flex; justify-content: space-between; gap: 12px; padding: 12px 0;@vien"><span><span style="display: block; font-weight: 600">@kq.Ten</span><span style="font-size: 13px; color: #52606D">@kq.ThoiGian</span></span><span style="font-family: 'JetBrains Mono', monospace; font-weight: 600; color: @mau">@kq.Diem/@kq.Tong</span></div>
}
</div>
</section>

<section style="flex: 1 1 340px; min-width: 0; background: #FFFFFF; border: 1px solid #E1E6EB; border-radius: 18px; padding: 24px; display: flex; flex-direction: column">
<h2 style="margin: 0 0 6px; font-size: 18px">Nên ôn lại</h2>
<p style="margin: 0 0 14px; font-size: 14px; color: #52606D">Dựa trên các câu em hay sai</p>
<div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px">
@foreach (var cd in Model.ChuDeNenOn)
{
<span style="padding: 6px 12px; border-radius: 99px; background: #FDF0DC; color: #7A4505; font-size: 14px; font-weight: 600">@cd</span>
}
</div>
<form asp-controller="Home" asp-action="BaiHoc" method="get" style="margin-top: auto; display: flex; gap: 8px">
<label for="quickask" style="position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0)">Hỏi nhanh AI</label>
<input id="quickask" name="hoi" type="text" placeholder="Hỏi nhanh AI…" style="flex: 1 1 auto; min-width: 0; min-height: 46px; padding: 0 14px; border-radius: 12px; border: 1px solid #C5CED6; font: inherit; color: #0F1B2D">
<button type="submit" aria-label="Gửi câu hỏi" style="width: 46px; height: 46px; border: none; border-radius: 12px; background: #0E7C66; display: flex; align-items: center; justify-content: center; cursor: pointer">
<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13"></path><path d="M22 2l-7 20-4-9-9-4z"></path></svg>
</button>
</form>
</section>
</div>
</main>

</div>
