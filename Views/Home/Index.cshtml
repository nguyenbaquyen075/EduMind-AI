<!-- ==================== HERO CHÍNH 100% MẪU GEOEDU ==================== -->
<section class="tc-hero" id="heroStage">
<!-- Lớp ảnh nền đúng tỷ lệ gốc (không zoom) + hiệu ứng SVG khóa tọa độ -->
<div class="tc-hero-bg-wrap" aria-hidden="true">
<div class="tc-hero-scene" id="heroBg">
<img class="tc-hero-bg" src="~/images/hero-geoedu.webp" asp-append-version="true" alt="Học sinh mỉm cười cầm bản đồ trước quả địa cầu 3D, bốn khung ảnh kỳ quan Việt Nam và thế giới, cùng cuốn sách mở nổi mô hình đảo và ngọn hải đăng" fetchpriority="high" decoding="sync">

<!-- Hiệu ứng khóa tọa độ 1600x900 (preserveAspectRatio="xMidYMid slice") -->
<svg class="tc-hero-art-fx" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice">
<defs>
<radialGradient id="geoOrbGlow" cx="50%" cy="50%" r="50%">
<stop offset="0%" stop-color="#FFFFFF" stop-opacity="1"/>
<stop offset="45%" stop-color="#E0E7FF" stop-opacity="0.88"/>
<stop offset="100%" stop-color="#8B5CF6" stop-opacity="0"/>
</radialGradient>
<radialGradient id="geoBeaconGlow" cx="50%" cy="50%" r="50%">
<stop offset="0%" stop-color="#FEF9C3" stop-opacity="1"/>
<stop offset="40%" stop-color="#FDE047" stop-opacity="0.6"/>
<stop offset="100%" stop-color="#F59E0B" stop-opacity="0"/>
</radialGradient>
<linearGradient id="geoOrbitStroke" x1="0%" y1="0%" x2="100%" y2="100%">
<stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.1"/>
<stop offset="45%" stop-color="#FFFFFF" stop-opacity="0.95"/>
<stop offset="75%" stop-color="#BAE6FD" stop-opacity="0.9"/>
<stop offset="100%" stop-color="#C4B5FD" stop-opacity="0.1"/>
</linearGradient>
<linearGradient id="geoBookArc" x1="0%" y1="0%" x2="100%" y2="0%">
<stop offset="0%" stop-color="#818CF8" stop-opacity="0"/>
<stop offset="45%" stop-color="#FFFFFF" stop-opacity="0.95"/>
<stop offset="75%" stop-color="#A78BFA" stop-opacity="0.85"/>
<stop offset="100%" stop-color="#38BDF8" stop-opacity="0"/>
</linearGradient>
<filter id="geoSoftBlur" x="-40%" y="-40%" width="180%" height="180%">
<feGaussianBlur stdDeviation="4.5"/>
</filter>
</defs>

<!-- 1. Đường bay chấm bi & vệt sáng theo máy bay góc trên phải -->
<g class="tc-svg-plane">
<path id="geoPlaneArc" d="M 1165 205 Q 1275 130 1392 166" fill="none" stroke="#FFFFFF" stroke-opacity="0.85" stroke-width="2.4" stroke-dasharray="6 9" stroke-linecap="round" class="tc-plane-dots"/>
<circle r="8" fill="url(#geoOrbGlow)">
<animateMotion dur="5.2s" repeatCount="indefinite"><mpath href="#geoPlaneArc"/></animateMotion>
</circle>
<circle r="3" fill="#FFFFFF">
<animateMotion dur="5.2s" repeatCount="indefinite"><mpath href="#geoPlaneArc"/></animateMotion>
</circle>
</g>

<!-- 2. Vòng quỹ đạo sáng & hạt năng lượng quay quanh quả địa cầu xanh -->
<g class="tc-svg-orbits">
<path id="geoGlobeOrbit1" d="M 885 280 A 305 128 -22 1 0 1365 445 A 305 128 -22 1 0 885 280 Z" fill="none" stroke="url(#geoOrbitStroke)" stroke-width="2.4" stroke-dasharray="190 150 90 130" class="tc-orbit-1"/>
<path id="geoGlobeOrbit2" d="M 845 360 A 265 162 24 1 0 1320 270 A 265 162 24 1 0 845 360 Z" fill="none" stroke="url(#geoOrbitStroke)" stroke-width="1.8" stroke-dasharray="150 180 75 140" class="tc-orbit-2"/>

<circle r="10" fill="url(#geoOrbGlow)">
<animateMotion dur="9.5s" repeatCount="indefinite"><mpath href="#geoGlobeOrbit1"/></animateMotion>
</circle>
<circle r="3.8" fill="#FFFFFF">
<animateMotion dur="9.5s" repeatCount="indefinite"><mpath href="#geoGlobeOrbit1"/></animateMotion>
</circle>

<circle r="8.5" fill="url(#geoOrbGlow)">
<animateMotion dur="12.5s" begin="-4.5s" repeatCount="indefinite"><mpath href="#geoGlobeOrbit2"/></animateMotion>
</circle>
<circle r="3.4" fill="#E0F2FE">
<animateMotion dur="12.5s" begin="-4.5s" repeatCount="indefinite"><mpath href="#geoGlobeOrbit2"/></animateMotion>
</circle>
</g>

<!-- 3. Đèn ngọn hải đăng nhấp nháy & vệt sáng ma thuật lướt qua cuốn sách mở -->
<g class="tc-svg-book-magic">
<g transform="translate(1234, 622)">
<circle r="38" fill="url(#geoBeaconGlow)" class="tc-beacon-pulse"/>
<rect x="-26" y="-1" width="52" height="2" rx="1" fill="#FEF9C3" opacity="0.9" class="tc-beacon-ray"/>
<rect x="-1" y="-22" width="2" height="44" rx="1" fill="#FEF9C3" opacity="0.9" class="tc-beacon-ray"/>
</g>
<path id="geoBookWave" d="M 820 742 Q 1085 676 1350 748" fill="none" stroke="url(#geoBookArc)" stroke-width="3.2" stroke-linecap="round" stroke-dasharray="180 620" class="tc-book-arc-flow"/>
<circle r="8" fill="url(#geoOrbGlow)">
<animateMotion dur="4.6s" repeatCount="indefinite"><mpath href="#geoBookWave"/></animateMotion>
</circle>
</g>

<!-- 4. Sóng radar tỏa nhẹ tại 2 ghim bản đồ xanh & đỏ trên trang sách mở -->
<g transform="translate(901, 690)">
<circle r="14" fill="none" stroke="#38BDF8" stroke-width="2.2" class="tc-pin-radar"/>
<circle r="14" fill="none" stroke="#60A5FA" stroke-width="1.6" class="tc-pin-radar tc-pr-2"/>
</g>
<g transform="translate(1376, 690)">
<circle r="14" fill="none" stroke="#F87171" stroke-width="2.2" class="tc-pin-radar"/>
<circle r="14" fill="none" stroke="#FCA5A5" stroke-width="1.6" class="tc-pin-radar tc-pr-2"/>
</g>
</svg>
</div>
</div>

<!-- Lớp Canvas đốm sáng pastel bay nhẹ + vệt sao khi di chuột -->
<canvas class="tc-hero-canvas" id="heroCanvas" aria-hidden="true"></canvas>

