@model TrangChuViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "GeoEdu – Học Địa lý thật dễ!";

    var monSu = Model.MonHoc.FirstOrDefault(m => m.Ten.StartsWith("Lịch sử"));
    var monDia = Model.MonHoc.FirstOrDefault(m => m.Ten.StartsWith("Địa lí"));
    var daDangNhap = User.Identity?.IsAuthenticated == true;

    var duLieuLoTrinh = System.Text.Json.JsonSerializer.Serialize(new
    {
        su = monSu?.Chuong ?? [],
        dia = monDia?.Chuong ?? [],
    });

    var duLieuTimKiem = System.Text.Json.JsonSerializer.Serialize(new
    {
        goi = Model.GoiHoc.Select(g => new { ten = g.Ten, nhan = g.Nhan, url = Url.Action("Mua", "ThanhToan", new { id = g.Id }) ?? "#khoahoc" }),
        mon = Model.MonHoc.Select(m => new { ten = m.Ten, baiDau = Url.Action("BaiHoc", "Home", new { id = m.BaiDauId }) ?? "#khoahoc", chuong = m.Chuong }),
    });
}
@section Head {
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,700&family=Dancing+Script:wght@700&family=Patrick+Hand&display=swap">
<link rel="stylesheet" href="~/css/trang-chu.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/trang-chu-chat.css" asp-append-version="true">
<style>
