@model TrangChuViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "SửĐịa.AI – Học tập thông minh";

    // Ảnh bìa và số chủ đề của gói lấy theo môn có trong tên gói
    var monSu = Model.MonHoc.FirstOrDefault(m => m.Ten.StartsWith("Lịch sử"));
    var monDia = Model.MonHoc.FirstOrDefault(m => m.Ten.StartsWith("Địa lí"));

    // Dữ liệu cho phần Lộ trình cá nhân (chạy bằng JS)
    var duLieuLoTrinh = System.Text.Json.JsonSerializer.Serialize(new
    {
        su = monSu?.Chuong ?? [],
        dia = monDia?.Chuong ?? [],
    });
}
@section Head {
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&display=swap">
<link rel="stylesheet" href="~/css/trang-chu.css" asp-append-version="true">
}

<div class="tc-page">
<div class="tc-glow tc-glow-1" aria-hidden="true"></div>
<div class="tc-glow tc-glow-2" aria-hidden="true"></div>
<div class="tc-glow tc-glow-3" aria-hidden="true"></div>
<div class="tc-glow tc-glow-4" aria-hidden="true"></div>

<header class="tc-head">
<div class="tc-wrap tc-head-row">
<a href="/" class="tc-logo">SửĐịa<span>.AI</span></a>
<nav aria-label="Menu chính" class="tc-nav">
<a href="#chatbot">Chatbot AI</a>
<a href="#khoahoc">Khoá học</a>
<a href="#giangvien">Giảng viên</a>
<a href="#lotrinh">Lộ trình</a>
<a href="#lienhe">Liên hệ</a>
<a asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập</a>
<a asp-controller="TaiKhoan" asp-action="DangKy" class="tc-btn tc-btn-primary">Đăng ký học</a>
</nav>
</div>
</header>

<section id="chatbot" class="tc-hero">
<div class="tc-hero-photo" role="img" aria-label="Góc học tập sáng: chồng sách, đèn bàn, bản đồ Việt Nam cổ, laptop, quả địa cầu và chậu cây trên bàn gỗ"></div>
<div class="tc-sparks" aria-hidden="true">
<span style="left: 8%; width: 7px; height: 7px; animation-duration: 11s; animation-delay: 0s"></span>
<span style="left: 26%; width: 6px; height: 6px; animation-duration: 13s; animation-delay: 4s"></span>
<span style="left: 40%; width: 6px; height: 6px; animation-duration: 12.5s; animation-delay: 5.5s"></span>
<span style="left: 52%; width: 8px; height: 8px; animation-duration: 12s; animation-delay: 7.5s"></span>
<span style="left: 64%; width: 7px; height: 7px; animation-duration: 11s; animation-delay: 1.2s"></span>
<span style="left: 76%; width: 6px; height: 6px; animation-duration: 11.5s; animation-delay: 2.5s"></span>
<span style="left: 92%; width: 7px; height: 7px; animation-duration: 13s; animation-delay: 9s"></span>
</div>
<div class="tc-hero-fade" aria-hidden="true"></div>

<div class="tc-hero-inner">
<div class="tc-hero-title tc-up">
<p>SửĐịa.AI</p>
<h1><span class="tc-shimmer">Học tập thông minh</span></h1>
</div>

<div class="tc-up tc-u2"><div class="tc-shake"><div class="tc-glass" id="chatGlass">
<div class="tc-chat-head">
<div>
<p class="tc-chat-title">Hỏi AI</p>
<p class="tc-chat-sub">Hỏi đáp Lịch sử, Địa lí</p>
</div>
<div class="tc-chat-tools">
<label for="chatMon" class="tc-sr">Chọn môn học</label>
<select id="chatMon" class="tc-lg">
<option value="">Tất cả môn học</option>
<option value="lich-su-12">Lịch sử 12</option>
<option value="dia-li-12">Địa lí 12</option>
</select>
<button type="button" id="chatMoi" class="tc-lg"><svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>Đoạn chat mới</button>
</div>
</div>

<div class="tc-chat-list" id="chatList">
<div class="tc-chat-inner" id="chatInner">
<div class="tc-empty" id="chatEmpty" hidden>
<span class="tc-empty-icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z"></path></svg></span>
<p class="tc-empty-title">Bạn muốn hỏi gì hôm nay?</p>
<p class="tc-empty-sub">Thử một câu gợi ý bên dưới.</p>
<div class="tc-chips">
@foreach (var q in Model.CauHoiGoiY)
{
<button type="button" class="tc-lg tc-chip" data-q="@q">@q</button>
}
</div>
</div>
<div class="tc-typing" id="chatTyping" hidden>
<span class="tc-ai-icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z"></path></svg></span>
<span class="tc-lg tc-dots"><span class="tc-dot"></span><span class="tc-dot"></span><span class="tc-dot"></span></span>
</div>
</div>
</div>

<div class="tc-chat-foot">
<form id="chatForm" class="tc-lg tc-chat-form">
<label for="chatHoi" class="tc-sr">Câu hỏi cho AI</label>
<textarea id="chatHoi" rows="1"placeholder="Nhập câu hỏi của bạn về Sử, Địa..."></textarea>
<div class="tc-chat-actions">
<span></span>
<button type="submit" id="chatGui" class="tc-send" disabled>Gửi<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"></path><path d="M5 12l7-7 7 7"></path></svg></button>
</div>
</form>
</div>
</div></div></div>
</div>
</section>

<section id="khoahoc" class="tc-section">
<div class="tc-wrap">
<div class="tc-section-head">
<span class="tc-bar" aria-hidden="true"></span>
<p class="tc-eyebrow">KHOÁ HỌC</p>
<h2>Chọn khoá phù hợp với bạn</h2>
<p class="tc-lead">Khoá nào cũng có chatbot AI hỏi đáp theo tài liệu.</p>
</div>
<div class="tc-courses">
@foreach (var g in Model.GoiHoc)
{
    var coSu = g.Ten.Contains("Sử", StringComparison.OrdinalIgnoreCase);
    var coDia = g.Ten.Contains("Địa", StringComparison.OrdinalIgnoreCase);
    var combo = coSu && coDia;
    var mon = combo ? null : coSu ? monSu : coDia ? monDia : null;
    var nhanMon = combo ? $"COMBO · {Model.MonHoc.Count} MÔN" : mon is null ? g.Nhan.ToUpper() : $"{(coSu ? "LỊCH SỬ" : "ĐỊA LÍ")} · {mon.Chuong.Count} CHỦ ĐỀ";
    var lopMon = combo ? "is-combo" : coSu ? "is-su" : "is-dia";
<article class="tc-card tc-lift tc-course @lopMon @(g.NoiBat ? "is-best" : "")">
<div class="tc-cover" aria-hidden="true">
    @if (combo && monSu is not null && monDia is not null)
    {
<img src="@monSu.Anh" alt="" loading="lazy" class="tc-cover-half tc-cover-left">
<img src="@monDia.Anh" alt="" loading="lazy" class="tc-cover-half tc-cover-right">
<span class="tc-cover-text">Sử + Địa</span>
    }
    else if (mon is not null)
    {
<img src="@mon.Anh" alt="" loading="lazy">
<span class="tc-cover-text">@mon.Ten</span>
    }
    else
    {
<span class="tc-cover-text">@g.Ten</span>
    }
    @if (g.NoiBat)
    {
<span class="tc-badge">Phổ biến</span>
    }
</div>
<div class="tc-course-body">
<p class="tc-course-tag">@nhanMon</p>
<h3>@g.Ten</h3>
    @if (mon is not null)
    {
<p class="tc-course-desc">@mon.MoTa</p>
    }
<ul class="tc-checks">
    @foreach (var ql in g.QuyenLoi.Take(4))
    {
<li><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>@ql</li>
    }
</ul>
<div class="tc-course-foot">
<span class="tc-price">@(g.Gia is null ? "Sắp mở bán" : DinhDang.Gia(g.Gia))</span>
<a asp-controller="ThanhToan" asp-action="Mua" asp-route-id="@g.Id" class="tc-btn @(g.NoiBat ? "tc-btn-primary" : "tc-btn-soft")">Chọn khoá</a>
</div>
    @if (mon is not null)
    {
<a asp-controller="Home" asp-action="BaiHoc" asp-route-id="@mon.BaiDauId" class="tc-trial">Đọc thử bài đầu tiên →</a>
    }
</div>
</article>
}
</div>
</div>
</section>

<section id="giangvien" class="tc-section">
<div class="tc-wrap">
<div class="tc-section-head is-center">
<span class="tc-bar" aria-hidden="true"></span>
<p class="tc-eyebrow">GIẢNG VIÊN</p>
<h2>Đội ngũ biên soạn tài liệu</h2>
<p class="tc-lead">Tài liệu chatbot dùng để trả lời đều do giảng viên biên soạn và kiểm duyệt.</p>
</div>
<div class="tc-teachers">
@{
    var dsGv = Model.GiangVien.Count > 0
        ? Model.GiangVien.ToList()
        : new List<GiangVienTrangChu> { new("[Tên giảng viên]", "Lịch sử"), new("[Tên giảng viên]", "Lịch sử"), new("[Tên giảng viên]", "Địa lí"), new("[Tên giảng viên]", "Địa lí") };
}
@foreach (var gv in dsGv)
{
    var laDia = gv.Mon.StartsWith("Địa");
<div class="tc-card tc-lift tc-teacher @(laDia ? "is-dia" : "is-su")">
<div class="tc-avatar" aria-hidden="true">
<svg viewBox="0 0 120 120" width="120" height="120"><circle cx="60" cy="46" r="22" fill="currentColor" opacity="0.55"></circle><path d="M18 112c4-24 22-38 42-38s38 14 42 38z" fill="currentColor" opacity="0.55"></path></svg>
</div>
<p class="tc-teacher-name">@gv.HoTen</p>
<span class="tc-pill">@gv.Mon</span>
</div>
}
</div>
</div>
</section>

<section id="lotrinh" class="tc-section">
<div class="tc-wrap tc-plan">
<div class="tc-card tc-plan-form">
<div class="tc-section-head">
<span class="tc-bar" aria-hidden="true"></span>
<p class="tc-eyebrow">LỘ TRÌNH CÁ NHÂN</p>
<h2>AI gợi ý lộ trình cho riêng bạn</h2>
<p class="tc-lead">Chọn vài thông tin, AI sắp xếp bài học theo từng tuần.</p>
</div>
<div class="tc-opt-group" data-key="mon"><p>Môn ôn thi</p><div role="group" aria-label="Môn ôn thi">
<button type="button" data-v="su">Lịch sử</button><button type="button" data-v="dia">Địa lí</button><button type="button" data-v="both" aria-pressed="true">Cả hai môn</button>
</div></div>
<div class="tc-opt-group" data-key="diem"><p>Mục tiêu điểm</p><div role="group" aria-label="Mục tiêu điểm">
<button type="button" data-v="7">7 điểm</button><button type="button" data-v="8" aria-pressed="true">8 điểm</button><button type="button" data-v="9">9+ điểm</button>
</div></div>
<div class="tc-opt-group" data-key="thang"><p>Thời gian còn lại</p><div role="group" aria-label="Thời gian còn lại">
<button type="button" data-v="1">1 tháng</button><button type="button" data-v="3" aria-pressed="true">3 tháng</button><button type="button" data-v="6">6 tháng</button>
</div></div>
<div class="tc-opt-group" data-key="phut"><p>Mỗi ngày học</p><div role="group" aria-label="Mỗi ngày học">
<button type="button" data-v="30">30 phút</button><button type="button" data-v="60" aria-pressed="true">60 phút</button><button type="button" data-v="90">90 phút</button>
</div></div>
<button type="button" id="planTao" class="tc-btn tc-btn-primary tc-btn-block"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z"></path></svg>Tạo lộ trình</button>
</div>

<div class="tc-plan-panel">
<div class="tc-plan-body" id="planBody">
<div class="tc-plan-msg" id="planMsg" hidden>
<div class="tc-plan-user" id="planUser"></div>
<div class="tc-plan-reply"><span class="tc-ai-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z"></path></svg></span><p id="planReply"></p></div>
</div>
<div class="tc-plan-idle" id="planIdle">
<span class="tc-plan-icon" aria-hidden="true"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6l6-3 6 3 6-3v15l-6 3-6-3-6 3z"></path><path d="M9 3v15"></path><path d="M15 6v15"></path></svg></span>
<p class="tc-plan-idle-title">Lộ trình của bạn sẽ hiện ở đây</p>
<p>Chọn thông tin bên trái, hoặc nhắn cho AI ở ô bên dưới.</p>
</div>
<div class="tc-plan-loading" id="planLoading" hidden>AI đang phân tích và sắp xếp bài học<span class="tc-dots"><span class="tc-dot"></span><span class="tc-dot"></span><span class="tc-dot"></span></span></div>
<div id="planResult" hidden>
<div class="tc-plan-top"><div><p class="tc-eyebrow">LỘ TRÌNH ĐỀ XUẤT</p><p class="tc-plan-title" id="planTitle"></p></div><span class="tc-plan-weeks" id="planWeeks"></span></div>
<ol class="tc-phases" id="planPhases"></ol>
<div class="tc-plan-daily"><p class="tc-eyebrow">MỖI NGÀY</p><p id="planDaily"></p></div>
<a asp-controller="TaiKhoan" asp-action="DangKy" class="tc-btn tc-btn-primary">Lưu lộ trình và bắt đầu học</a>
</div>
</div>
<form id="planForm" class="tc-plan-form-chat">
<label for="planHoi" class="tc-sr">Nhắn cho AI về lộ trình</label>
<input id="planHoi" type="text" placeholder="VD: Em còn 2 tháng, muốn 8 điểm Sử, mỗi ngày học 1 tiếng">
<button type="submit" class="tc-btn tc-btn-primary">Gửi</button>
</form>
</div>
</div>
</section>

<section class="tc-spacer" aria-hidden="true"></section>

<footer id="lienhe" class="tc-foot">
<div class="tc-wrap"><div class="tc-foot-line"></div></div>
<div class="tc-wrap tc-foot-grid">
<div><p class="tc-logo">SửĐịa<span>.AI</span></p><p>Học tập thông minh với chatbot AI cho Lịch sử &amp; Địa lí 12.</p></div>
<div><p class="tc-foot-title">Khoá học</p><a href="#khoahoc">Lịch sử 12</a><a href="#khoahoc">Địa lí 12</a><a href="#khoahoc">Trọn bộ Sử &amp; Địa</a></div>
<div><p class="tc-foot-title">Hỗ trợ</p><a href="#lotrinh">Lộ trình cá nhân</a><a href="#">Hướng dẫn thanh toán</a><a href="#">Chính sách bảo mật</a></div>
<div><p class="tc-foot-title">Liên hệ</p><span>[EMAIL]</span><span>[SỐ ĐIỆN THOẠI]</span><span>[ĐỊA CHỈ]</span></div>
</div>
</footer>
</div>

<template id="tplUser"><div class="tc-msg tc-msg-user"></div></template>
<template id="tplAi"><div class="tc-msg tc-msg-ai">
<span class="tc-ai-icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z"></path></svg></span>
<div class="tc-lg tc-ai-card">
<p class="tc-ai-label" data-f="label"></p>
<p class="tc-ai-text"><span data-f="text"></span><sup data-f="mark"></sup><span class="tc-caret" data-f="caret">▍</span></p>
<p class="tc-ai-source" data-f="source" hidden></p>
</div>
</div></template>
<script type="application/json" id="loTrinhData">@Html.Raw(duLieuLoTrinh)</script>
@Html.AntiForgeryToken()

@section Scripts {
<script src="~/js/trang-chu.js" asp-append-version="true"></script>
}
