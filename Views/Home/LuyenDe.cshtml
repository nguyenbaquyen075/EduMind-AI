@model LuyenDeViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Luyện đề";
}
@section Head {
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="~/css/khoa-hoc.css" asp-append-version="true">
}

<div class="kh-shell">

<partial name="_MenuTaiKhoan" model="Model.Menu" />

<main class="kh-main">
<div class="kh-inner">
<h1 class="kh-title kh-title-page">Luyện đề</h1>

<div class="lc-grid">
@foreach (var l in Model.Khoa)
{
    var k = l.Khoa;
    var diaLi = k.Id.StartsWith("dia");
<a asp-controller="Home" asp-action="LuyenDe" asp-route-id="@k.Id" class="lc @(diaLi ? "lc--cam" : "lc--xanh")">
@if (diaLi)
{
<svg class="lc-deco" aria-hidden="true" viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="100" cy="100" r="92"></circle><ellipse cx="100" cy="100" rx="42" ry="92"></ellipse><path d="M8 100h184M20 54h160M20 146h160"></path></svg>
}
<span class="lc-top">
<span class="lc-ico" aria-hidden="true">
@if (diaLi)
{
<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18"></path><path d="M12 3a14 14 0 0 1 0 18a14 14 0 0 1 0-18z"></path></svg>
}
else
{
<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5L12 4l9 5.5z"></path><path d="M5.5 10v8M10 10v8M14 10v8M18.5 10v8"></path><path d="M3 20.5h18"></path></svg>
}
</span>
<span class="lc-head">
<span class="lc-namerow">
<span class="lc-name">@k.Ten</span>
<span class="lc-chip">
@if (k.DaMo)
{
<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><rect x="4" y="13" width="4" height="7" rx="1"></rect><rect x="10" y="9" width="4" height="11" rx="1"></rect><rect x="16" y="5" width="4" height="15" rx="1"></rect></svg>
@(l.DaLuyen > 0 ? "Đang luyện" : "Chưa luyện")
}
else
{
<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2z"></path><path d="M22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z"></path></svg>
@:Học thử
}
<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"></path></svg>
</span>
</span>
<span class="lc-tag">@(diaLi ? "Khám phá thế giới quanh ta" : "Khám phá quá khứ, kiến tạo tương lai")</span>
</span>
</span>

<span class="lc-stats so">
@if (k.DaMo)
{
<span class="lc-stat"><span class="lc-sico xanh" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="2"></rect><path d="M9 8h6M9 12h6M9 16h3"></path></svg></span><span><strong>@l.DaLuyen/@l.TongBai</strong><small>bài đã luyện</small></span></span>
<span class="lc-stat"><span class="lc-sico vang" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5L2.5 9.4l6.6-.9z"></path></svg></span><span><strong>@DinhDang.Diem(l.DiemTrungBinh)</strong><small>điểm TB</small></span></span>
<span class="lc-stat"><span class="lc-sico lam" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="2"></rect><path d="M9 8h6M9 12h6M9 16h6"></path></svg></span><span><strong>@l.DeThi.Count</strong><small>đề thi thử</small></span></span>
}
else
{
<span class="lc-stat"><span class="lc-sico dao" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path><path d="M14 3v5h5M9 13h6M9 17h6"></path></svg></span><span><strong>@l.TongBai</strong><small>bài tập</small></span></span>
<span class="lc-vach" aria-hidden="true"></span>
<span class="lc-stat"><span class="lc-sico tim" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="2"></rect><path d="M9 8h6M9 12h6M9 16h3"></path></svg></span><span><strong class="nho">Luyện thử miễn phí</strong><small>bài 1</small></span></span>
}
</span>

@if (k.DaMo)
{
<span class="lc-prog so">
<span class="lc-bar" role="progressbar" aria-label="Tiến độ luyện đề @k.Ten" aria-valuenow="@l.TienDoPhanTram" aria-valuemin="0" aria-valuemax="100"><span style="width: @(l.TienDoPhanTram)%"></span></span>
<span class="lc-pct">@(l.TienDoPhanTram)%</span>
</span>
}

<span class="lc-foot">
<span class="lc-btn">@(k.DaMo ? "Vào luyện đề" : "Luyện thử")
<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
@if (diaLi)
{
<svg class="lc-btn-deco" aria-hidden="true" viewBox="0 0 120 40" fill="currentColor"><path d="M0 40L28 18l14 10 22-22 26 20 14-8 16 22z"></path></svg>
}
else
{
<svg class="lc-btn-deco" aria-hidden="true" viewBox="0 0 60 40" fill="currentColor"><path d="M4 8c8-3 16-3 24 2v28c-8-5-16-5-24-2zM32 10c8-5 16-5 24-2v28c-8-3-16-3-24 2z"></path></svg>
}
</span>
@if (diaLi)
{
<span class="lc-compass" aria-hidden="true"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 4.5l2 7.5-2 7.5-2-7.5z" fill="currentColor" fill-opacity=".25"></path></svg></span>
}
</span>
</a>
}
</div>
</div>
</main>

</div>
