@model KhoaHocViewModel
@{
    Layout = "_Layout";
    var k = Model.DangChon!;
    ViewData["Title"] = $"{k.Ten} – Khoá của tôi";
    var tiep = k.BaiHocTiep;
}
@section Head {
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="~/css/khoa-hoc.css" asp-append-version="true">
}

<div class="kh-shell">

<partial name="_MenuTaiKhoan" model="Model.Menu" />

<main class="kh-main">
<div class="kh-inner">

<nav class="kd-crumb" aria-label="Đường dẫn">
<a asp-controller="Home" asp-action="KhoaHoc" asp-route-id="">Khoá của tôi</a>
<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"></path></svg>
<span aria-current="page">@k.Ten</span>
</nav>

@* ---------------------------------------------------------------- Thông tin khoá *@
<section class="kd-hero" aria-labelledby="ten-khoa">
<div>
<h1 id="ten-khoa" class="kh-title">@k.Ten</h1>
<p class="kd-desc">@k.MoTa</p>
@if (k.DaMo)
{
<div class="kd-progress">
<div class="kc-progress-label so"><span><strong>@k.BaiDaHoc</strong>/@k.TongBai bài đã học</span><span>@(k.TienDoPhanTram)%</span></div>
<div class="kc-bar" role="progressbar" aria-label="Tiến độ khoá học" aria-valuenow="@k.TienDoPhanTram" aria-valuemin="0" aria-valuemax="100"><span style="width: @(k.TienDoPhanTram)%"></span></div>
</div>
}
<div class="kd-actions">
@if (tiep is not null)
{
<a asp-controller="Home" asp-action="BaiHoc" asp-route-id="@tiep.Id" class="kh-btn">@(k.BaiDaHoc > 0 ? "Học tiếp" : k.DaMo ? "Bắt đầu học" : "Học thử") Bài @tiep.So
<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
}
@if (k.DaMo)
{
<a asp-controller="Home" asp-action="LuyenDe" asp-route-id="@k.Id" class="kh-btn phu">Luyện đề</a>
}
else
{
<a asp-controller="Home" asp-action="Index" asp-fragment="goi" class="kh-btn phu">Mở khoá đầy đủ</a>
}
</div>
</div>
<img class="kd-cover" src="@k.Anh" alt="" width="960" height="540">
</section>


@* ---------------------------------------------------------------- Nội dung khoá *@
<section aria-labelledby="noi-dung-khoa">
<div class="kh-section-head">
<h2 id="noi-dung-khoa" class="kh-h2">Nội dung khoá học</h2>
</div>

<div class="kh-panel mo">
@{ var soChuDe = 0; }
@foreach (var chuong in k.Chuong)
{
    soChuDe++;
    // "Chủ đề 1 · Thế giới…" -> nhãn "Chủ đề 1" + tên
    var phan = chuong.Ten.Split(" · ", 2);
<details class="kh-chapter">
<summary>
<span>
<span class="kh-chapter-label">@phan[0]</span>
<span class="kh-chapter-name">@(phan.Length > 1 ? phan[1] : "")</span>
</span>
<span class="kh-chapter-count so">@chuong.Bai.Count(b => b.TrangThai == TrangThaiBai.DaHoc)/@chuong.Bai.Count bài
<svg class="kh-chevron" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>
</span>
</summary>
<ol class="kh-lessons">
    @foreach (var b in chuong.Bai)
    {
        var meta = $"Bài {b.So} · {b.SoPhut} phút";
<li>
        @if (b.BiKhoa)
        {
<div class="kh-lesson khoa">
<span class="kh-status khoa" role="img" aria-label="Cần mở khoá"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg></span>
<span><span class="kh-lesson-title">@b.Ten</span><span class="kh-lesson-meta so">@meta</span></span>
</div>
        }
        else if (b.TrangThai == TrangThaiBai.DangHoc)
        {
<a asp-controller="Home" asp-action="BaiHoc" asp-route-id="@b.Id" class="kh-lesson dang">
<span class="kh-status dang" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5l11 7-11 7z"></path></svg></span>
<span><span class="kh-lesson-title">@b.Ten</span><span class="kh-lesson-meta so">@meta · <span class="xong">Đang học</span></span></span>
<span aria-hidden="true"></span>
</a>
        }
        else
        {
            var xong = b.TrangThai == TrangThaiBai.DaHoc;
<a asp-controller="Home" asp-action="BaiHoc" asp-route-id="@b.Id" class="kh-lesson">
            @if (xong)
            {
<span class="kh-status xong" role="img" aria-label="Đã học"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg></span>
            }
            else
            {
<span class="kh-status chua so" aria-hidden="true">@b.So</span>
            }
<span><span class="kh-lesson-title">@b.Ten</span><span class="kh-lesson-meta so">@meta</span></span>
<span aria-hidden="true"></span>
</a>
        }
        @if (!b.BiKhoa)
        {
<details class="kh-more">
<summary aria-label="Thêm việc cho bài @b.So" title="Thêm">
<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="1.8"></circle><circle cx="12" cy="12" r="1.8"></circle><circle cx="12" cy="19" r="1.8"></circle></svg>
</summary>
<ul class="kh-more-menu">
<li><a asp-controller="Home" asp-action="BaiHoc" asp-route-id="@b.Id"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2z"></path><path d="M22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z"></path></svg><span>Học bài</span></a></li>
<li><a asp-controller="Home" asp-action="LamCauHoi" asp-route-id="@b.Id"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg><span>Làm bài tập</span></a></li>
<li><a asp-controller="Home" asp-action="LuyenDe" asp-route-id="@k.Id" asp-fragment="chu-de-@soChuDe"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M7 9h10M7 13h10M7 17h6"></path></svg><span>Luyện tập cả chủ đề</span></a></li>
<li><a asp-controller="Home" asp-action="BaiHoc" asp-route-id="@b.Id" asp-fragment="tro-ly"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg><span>Hỏi AI về bài</span></a></li>
</ul>
</details>
        }
</li>
    }
</ol>
</details>
}
</div>
</section>

</div>
</main>

</div>

@section Scripts {
<script>
// Menu "⋯" ở dòng bài: chỉ mở một menu, bấm ra ngoài hoặc Esc thì đóng
(() => {
  const menus = [...document.querySelectorAll('.kh-more')];
  menus.forEach((m) => m.addEventListener('toggle', () => {
    if (m.open) menus.forEach((o) => { if (o !== m) o.open = false; });
  }));
  document.addEventListener('click', (e) => menus.forEach((m) => { if (m.open && !m.contains(e.target)) m.open = false; }));
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const mo = menus.find((m) => m.open);
    if (mo) { mo.open = false; mo.querySelector('summary').focus(); }
  });
})();
</script>
}
