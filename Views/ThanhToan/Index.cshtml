@model LichSuDonViewModel
@{
    ViewData["Title"] = "Đơn hàng của tôi · Sử Địa";
    var tabs = new[] { ("", "Tất cả", Model.TongDon), (TrangThaiDon.DaThanhToan, "Đã thanh toán", Model.SoDaTra), (TrangThaiDon.ChoThanhToan, "Chờ thanh toán", Model.SoDangCho), (TrangThaiDon.DaHuy, "Đã huỷ", Model.TongDon - Model.SoDaTra - Model.SoDangCho) };
}
@section Head {
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
<link rel="stylesheet" href="~/css/hoc-vien.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/thanh-toan.css" asp-append-version="true">
}
<div class="hv-trang">
<partial name="_MenuTaiKhoan" model="Model.Menu" />
<main class="hv-main tt">
<div class="tt-dau">
<div><h1>Đơn hàng của tôi</h1><p class="hv-mo-ta">Lịch sử mua gói, trạng thái thanh toán và biên lai.</p></div>
<a asp-action="Goi" class="hv-nut">Mua thêm gói</a>
</div>

<div class="hv-so">
<div><p>Tổng đã thanh toán</p><b>@DinhDang.Gia(Model.TongDaTra)</b></div>
<div><p>Đơn đã thanh toán</p><b>@Model.SoDaTra<small>/@Model.TongDon</small></b></div>
<div><p>Đang chờ thanh toán</p><b>@Model.SoDangCho</b></div>
</div>

<section class="hv-khoi">
<nav class="tt-tab" aria-label="Lọc đơn hàng">
@foreach (var (gt, ten, so) in tabs)
{
<a asp-action="Index" asp-route-tt="@gt" class="@(Model.Loc == gt ? "dang" : "")" aria-current="@(Model.Loc == gt ? "page" : null)">@ten <span>@so</span></a>
}
</nav>
@if (Model.Don.Count == 0)
{
<div class="tt-trong">
<svg aria-hidden="true" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><path d="M3 6h18M16 10a4 4 0 0 1-8 0"></path></svg>
<p>@(Model.TongDon == 0 ? "Bạn chưa có đơn mua gói nào." : "Không có đơn nào ở trạng thái này.")</p>
<a asp-action="Goi" class="hv-nut">Xem các gói học</a>
</div>
}
else
{
<div class="hv-bang-boc"><table class="hv-bang tt-bang">
<thead><tr><th>Mã đơn</th><th>Gói học</th><th>Ngày tạo</th><th class="so">Số tiền</th><th>Trạng thái</th><th></th></tr></thead>
<tbody>
@foreach (var d in Model.Don)
{
    var (chip, ten) = d.TrangThai switch
    {
        TrangThaiDon.DaThanhToan => ("xanh", "Đã thanh toán"),
        TrangThaiDon.DaHuy => ("", "Đã huỷ"),
        _ => ("vang", "Chờ thanh toán"),
    };
<tr>
<td class="hv-nowrap"><b>@d.MaThanhToan</b></td>
<td><b>@d.TenGoi</b><small>@d.SoThang tháng · @d.KhoaIds.Count khoá</small></td>
<td class="hv-nowrap">@DinhDang.GioNgay(d.NgayTao.ToLocalTime())@if (d.NgayThanhToan is DateTime tra) {<small>Trả lúc @tra.ToLocalTime().ToString("HH:mm dd/MM")</small>}</td>
<td class="so hv-nowrap"><b>@DinhDang.Gia(d.SoTien)</b></td>
<td><span class="hv-chip @chip">@ten</span></td>
<td class="tt-thao-tac">
@if (d.TrangThai == TrangThaiDon.DaThanhToan) { <a asp-action="HoaDon" asp-route-ma="@d.MaThanhToan" target="_blank" rel="noopener">Biên lai</a> }
else if (d.TrangThai == TrangThaiDon.ChoThanhToan) { <a asp-action="KetQua" asp-route-ma="@d.MaThanhToan">Kiểm tra trạng thái</a> }
else if (d.GoiBanId is int goi) { <a asp-action="Mua" asp-route-id="@goi">Mua lại</a> }
<a asp-action="KetQua" asp-route-ma="@d.MaThanhToan">Chi tiết</a>
</td>
</tr>
}
</tbody></table></div>
}
</section>
</main>
</div>
