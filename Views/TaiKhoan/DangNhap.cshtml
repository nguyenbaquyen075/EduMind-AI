@model DangNhapModel
@inject IWebHostEnvironment Env
@{
    Layout = "_KhungTaiKhoan";
    ViewData["Title"] = "Đăng nhập – Sử Địa";
}
<h1>Đăng nhập</h1>
<p>Chào mừng bạn quay lại.</p>
<form asp-action="DangNhap" method="post" novalidate>
<input type="hidden" asp-for="ReturnUrl">
<div asp-validation-summary="ModelOnly" class="tk-tong-loi" role="alert"></div>
<div class="tk-truong">
<label asp-for="Email">Email</label>
<input asp-for="Email" type="email" autocomplete="username" placeholder="ban@email.com" autofocus>
<span asp-validation-for="Email" class="tk-loi"></span>
</div>
<div class="tk-truong">
<label asp-for="MatKhau">Mật khẩu</label>
<div class="tk-mk"><input asp-for="MatKhau" type="password" autocomplete="current-password"><button type="button" class="tk-mat" data-hien-mk="MatKhau" aria-label="Hiện mật khẩu" aria-pressed="false"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"></path><circle cx="12" cy="12" r="3"></circle></svg></button></div>
<span asp-validation-for="MatKhau" class="tk-loi"></span>
</div>
<label class="tk-ghi-nho"><input asp-for="GhiNho" type="checkbox"> Ghi nhớ đăng nhập</label>
<button type="submit" class="tk-nut">Đăng nhập</button>
</form>
<p class="tk-duoi">Chưa có tài khoản? <a asp-action="DangKy">Đăng ký tài khoản</a></p>
@if (Env.IsDevelopment())
{
<div class="tk-mau">
<p>Tài khoản dùng thử (chỉ khi chạy Development)</p>
<code>admin@sudia.vn</code> · <code>giangvien@sudia.vn</code> · <code>hocvien@sudia.vn</code><br>Mật khẩu xem mục <code>TaiKhoanMau</code> trong appsettings.Development.json
</div>
}
